{
  "version": 3,
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release (arm-none-eabi)",
      "description": "Production bootloader build for i.MX RT1062",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/../../cmake/arm-none-eabi.cmake",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (arm-none-eabi)",
      "description": "Debug bootloader build with symbols",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/../../cmake/arm-none-eabi.cmake",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ]
}
