<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RootNamespace>NeurOne</RootNamespace>
    <AssemblyName>NeurOne</AssemblyName>
    <LangVersion>12</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The shipped NPPS library, copied beside the assembly so it is READ AT RUN
      TIME (NP-NPPS-REF-001 §1.6). The files themselves are bundled; nothing is
      parsed into C# at build time. A build-time cache cannot be correct here —
      nothing stops a .npps file changing after the build, and when one does the
      cache would be read in place of the edit, so the change never appears and
      there is nothing to notice. This is the Windows counterpart of Android's
      bundlePredefinedProtocols Gradle task and the iOS Resources folder
      reference.
    -->
    <Content Include="../../../protocols/predefined/**/*.npps"
             LinkBase="protocols/predefined"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../protocols/predefined/manifest.json"
             LinkBase="protocols/predefined"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The shared NPPS core (common/npps-ffi, OI-NPPS-CORE-01), copied beside the assembly for
      P/Invoke (Protocol/NppsCore.cs). Build it first:
        cargo build --release --locked --manifest-path common/Cargo.toml -p neurone-npps-ffi
      Conditional so a checkout without a Rust toolchain still restores and builds; a call into the
      core then throws DllNotFoundException.
    -->
    <Content Include="../../../common/target/release/neurone_npps_ffi.dll"
             Condition="Exists('../../../common/target/release/neurone_npps_ffi.dll')"
             Link="neurone_npps_ffi.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The compiler and its types are internal; the test project reads them directly. -->
    <InternalsVisibleTo Include="NeurOne.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ed25519 signing — wraps libsodium, matches CryptoKit Curve25519.Signing on iOS -->
    <PackageReference Include="NSec.Cryptography" Version="24.10.0" />
    <!-- DPAPI key protection (Windows-only, user-scope) -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
