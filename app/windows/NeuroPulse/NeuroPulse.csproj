<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RootNamespace>NeuroPulse</RootNamespace>
    <AssemblyName>NeuroPulse</AssemblyName>
    <LangVersion>12</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ed25519 signing — wraps libsodium, matches CryptoKit Curve25519.Signing on iOS -->
    <PackageReference Include="NSec.Cryptography" Version="24.10.0" />
    <!-- DPAPI key protection (Windows-only, user-scope) -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
