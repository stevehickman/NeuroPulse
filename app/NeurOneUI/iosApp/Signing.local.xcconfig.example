// Copy to Signing.local.xcconfig (git-ignored). Nothing here is a secret except, if you set it, the analytics token.
// Your Apple Developer Team ID: developer.apple.com -> Account -> Membership details (10 characters).
DEVELOPMENT_TEAM = ABCDE12345
// Automatic signing lets Xcode create the App ID (life.neurone.app) and the development profile.
CODE_SIGN_STYLE = Automatic
// Optional: analytics stays off while these are unset (REQ-SW03-20).
// ANALYTICS_HOST =
// POSTHOG_PROJECT_TOKEN =
