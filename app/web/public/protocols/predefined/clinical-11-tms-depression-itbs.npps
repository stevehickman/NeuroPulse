protocol "TMS — Depression Accelerated (iTBS)" {
    id: "30000011-0000-0000-0000-000000000000"
    description: "Figure-8 intermittent theta-burst (iTBS), left DLPFC, 90% rMT, 1800 pulses — accelerated SAINT/SNT-style dosing. Grade A. Multiple sessions/day."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: ["tms", "itbs", "clinical", "depression", "t2"]
    conditions: ["Major Depressive Disorder"]
    references: [["Neuromod protocol database §1 TMS accelerated", "docs/neuromod_neuro_protocols.md#1-tms-transcranial-magnetic-stimulation"], ["Cole 2022 SAINT", "docs/neuromod_neuro_protocols.md"]]
    duration: 10m

    tms {
        tms_protocol: iTBS
        frequency: 50Hz
        intensity_percent_mt: 90
        target: DLPFC_L
        pulse_count: 1800
    }
}
