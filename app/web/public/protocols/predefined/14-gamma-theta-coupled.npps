protocol "Gamma + Theta Coupled" {
    id: "1000000E-0000-0000-0000-000000000000"
    description: "Simultaneous 40Hz front-zone PBM and 6Hz rear-zone PBM with gamma-theta EEG coupling, binaural + isochronic audio, 40Hz visual entrainment, and BES."
    author: "NeuroPulse"
    version: "1.0"
    readonly: true
    tags: [focus, gamma, theta, coupled, advanced]
    duration: 20m

    pbm_transcranial {
        intensity: 75%
        frequency: 40Hz
        duty_cycle: 25%
        zones: front
        wavelength: 660_808nm
    }

    pbm_transcranial {
        intensity: 70%
        frequency: 6Hz
        duty_cycle: 25%
        zones: rear
        wavelength: 660_808nm
    }

    eeg_neurofeedback {
        band: gamma_theta
        channels: all
        closed_loop: true
    }

    audio_entrainment {
        binaural_hz: 40Hz
        isochronic_hz: 6Hz
        noise: pink
        carrier_hz: 440Hz
        volume: 60%
        eeg_adaptive: true
        bone_conduction_pacer: false
    }

    visual_stimulation {
        frequency: 40Hz
        mode: binocular
        emdr_cadence: 1Hz
    }

    bes_tacs {
        frequency: 40Hz
        intensity: 0.8mA
        waveform: sinusoidal
    }

}
