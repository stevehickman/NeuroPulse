protocol "tDCS — Schizophrenia (hallucinations)" {
    id: "30000034-0000-0000-0000-000000000000"
    description: "Anode left DLPFC (F3) + cathode left temporoparietal, 2mA, 20 min x2/day, 10 sessions, for auditory hallucinations. Grade B."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: ["tdcs", "clinical", "schizophrenia"]
    conditions: ["Schizophrenia"]
    references: [["Neuromod protocol database §3 tDCS schizophrenia (Grade B)", "docs/neuromod_neuro_protocols.md#3-tdcs--hd-tdcs-transcranial-direct-current-stimulation"], ["Brunelin 2012", "docs/neuromod_neuro_protocols.md"]]
    duration: 20m

    tdcs {
        intensity: 2mA
        electrode_pairs: [["F3", "TP3"]]
        ramp: 30s
    }
}
