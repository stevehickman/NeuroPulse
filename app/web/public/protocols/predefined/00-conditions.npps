# NeurOne condition registry (NP-NPPS Rev B)
# Standard condition names paired with an external definition link. Protocols
# reference these by name in their `conditions` field. When a user selects a
# condition, the app offers to open the link in an external browser. Codes are
# ICD-11 MMS where available.

condition "Alzheimer's Disease" {
    id: "41000001-0000-0000-0000-000000000000"
    link: "https://en.wikipedia.org/wiki/Alzheimer%27s_disease"
    code: "8A20"
}

