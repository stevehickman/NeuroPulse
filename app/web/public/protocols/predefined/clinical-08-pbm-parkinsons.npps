protocol "PBM — Parkinson's (transcranial)" {
    id: "30000008-0000-0000-0000-000000000000"
    description: "Transcranial 810 + 660nm PBM over motor/midline for Parkinson's disease. Grade C. Daily / 6x week, ≥12 weeks. NOTE: the evidence pairs head PBM with NECK (vagus) and ABDOMEN (gut) light — those peripheral sites are NOT NeurOne device functions; this preset is the transcranial channel only."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: ["pbm", "clinical", "parkinsons"]
    conditions: ["Parkinson's Disease"]
    references: [["PBM protocol database §8 (Grade C)", "docs/pbm_neuro_protocols.md#8-parkinsons-disease--grade-c"], ["Liebert 2021/2024 (gut-brain + transcranial)", "docs/pbm_neuro_protocols.md"]]
    duration: 20m

    pbm_transcranial {
        intensity: 50%
        frequency: 40Hz
        duty_cycle: 25%
        zones: all
        wavelength: 660_808nm
    }
}
