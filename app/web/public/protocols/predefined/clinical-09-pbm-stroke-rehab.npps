protocol "PBM — Stroke (chronic rehab)" {
    id: "30000009-0000-0000-0000-000000000000"
    description: "Perilesional + midline 810nm transcranial PBM plus intranasal for chronic post-stroke rehab, paired with physical/speech therapy. Grade C. 3x/week. Do NOT use for acute stroke (documented null; contraindicated as monotherapy)."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: ["pbm", "clinical", "stroke"]
    conditions: ["Stroke"]
    references: [["PBM protocol database §9 (Grade C, chronic)", "docs/pbm_neuro_protocols.md#9-stroke--grade-c-chronic-rehab--avoid-acute"]]
    duration: 15m

    pbm_transcranial {
        intensity: 40%
        frequency: 0Hz
        duty_cycle: 25%
        zones: all
        wavelength: 660_808nm
    }

    pbm_intranasal {
        intensity: 50%
        frequency: 0Hz
        duty_cycle: 25%
    }
}
