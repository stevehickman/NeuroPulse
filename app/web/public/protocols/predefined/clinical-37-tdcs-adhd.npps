protocol "tDCS — ADHD (anodal F3)" {
    id: "30000037-0000-0000-0000-000000000000"
    description: "Anodal left DLPFC (F3) or right DLPFC (F4), 1–2mA, 20–30 min, for attention/inhibition. Grade B. Repeated dosing needed (single-session can be null)."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: ["tdcs", "clinical", "adhd"]
    conditions: ["Attention Deficit Hyperactivity Disorder"]
    references: [["Neuromod protocol database §3 tDCS ADHD (Grade B)", "docs/neuromod_neuro_protocols.md#3-tdcs--hd-tdcs-transcranial-direct-current-stimulation"], ["Leffa 2022", "docs/neuromod_neuro_protocols.md"]]
    duration: 25m

    tdcs {
        intensity: 1.5mA
        electrode_pairs: [["F3", "Fp2"]]
        ramp: 30s
    }
}
