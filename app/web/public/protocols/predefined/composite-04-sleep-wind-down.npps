composite "Sleep Wind-Down" {
    id: "10000103-0000-0000-0000-000000000000"
    description: "Sequential transition from alpha calm to deep sleep preparation. No overlap — alpha calm finishes before sleep deep begins."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: [sleep, wind-down, transition, evening]
    conflict_resolution: sequential

    layer "Alpha Calm" {
        start: 0s
        duration: 10m
        intensity_scale: 1.0
    }

    layer "Deep Sleep" {
        start: 600s
        intensity_scale: 1.0
    }

}
