protocol "tDCS — Parkinson's (M1 / DLPFC)" {
    id: "30000040-0000-0000-0000-000000000000"
    description: "Anodal M1-leg for gait/freezing or DLPFC for executive/depression; multitarget > single. 2mA, 13–20 min. Grade C."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: ["tdcs", "clinical", "parkinsons"]
    conditions: ["Parkinson's Disease"]
    references: [["Neuromod protocol database §3 tDCS PD (Grade C)", "docs/neuromod_neuro_protocols.md#3-tdcs--hd-tdcs-transcranial-direct-current-stimulation"], ["Dagan 2018", "docs/neuromod_neuro_protocols.md"]]
    duration: 15m

    tdcs {
        intensity: 2mA
        electrode_pairs: [["Cz", "Fp2"]]
        ramp: 30s
    }
}
