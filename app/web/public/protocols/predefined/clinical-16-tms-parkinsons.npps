protocol "TMS — Parkinson's Motor (M1)" {
    id: "30000016-0000-0000-0000-000000000000"
    description: "Figure-8 HF rTMS over bilateral M1, 5–25Hz, 90–110% RMT, 1000 pulses, for PD motor symptoms. Grade B. ≥8 sessions."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: ["tms", "clinical", "parkinsons", "t2"]
    conditions: ["Parkinson's Disease"]
    references: [["Neuromod protocol database §1 TMS PD (Grade B)", "docs/neuromod_neuro_protocols.md#1-tms-transcranial-magnetic-stimulation"]]
    duration: 15m

    tms {
        tms_protocol: rTMS
        frequency: 10Hz
        intensity_percent_mt: 100
        target: M1_L
        pulse_count: 1000
    }
}
