protocol "TMS — PTSD (R-DLPFC)" {
    id: "30000014-0000-0000-0000-000000000000"
    description: "Figure-8 rTMS over right DLPFC (1 Hz or HF), augmenting exposure/CPT therapy. Grade B. 10–15 sessions."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: ["tms", "clinical", "ptsd", "t2"]
    conditions: ["Post-Traumatic Stress Disorder"]
    references: [["Neuromod protocol database §1 TMS PTSD (Grade B)", "docs/neuromod_neuro_protocols.md#1-tms-transcranial-magnetic-stimulation"]]
    duration: 20m

    tms {
        tms_protocol: rTMS
        frequency: 1Hz
        intensity_percent_mt: 100
        target: DLPFC_R
        pulse_count: 1200
    }
}
