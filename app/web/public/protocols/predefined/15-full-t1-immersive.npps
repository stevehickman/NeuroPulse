protocol "Full T1 Immersive" {
    id: "1000000F-0000-0000-0000-000000000000"
    description: "All 8 T1 modalities running simultaneously with balanced settings. For experienced users. Intranasal PBM and tDCS run in time-limited intervals within the 30-minute session."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: [comprehensive, all-modalities, advanced, T1]
    duration: 30m

    pbm_transcranial {
        intensity: 75%
        frequency: 40Hz
        duty_cycle: 25%
        zones: all
        wavelength: 660_808nm
    }

    pbm_intranasal {
        intensity: 60%
        frequency: 40Hz
        duty_cycle: 25%
        interval_on: 15m
        interval_off: 15m
        repeat: 1
    }

    eeg_neurofeedback {
        band: gamma
        channels: all
        closed_loop: true
    }

    bes_tacs {
        frequency: 40Hz
        intensity: 0.8mA
        waveform: sinusoidal
    }

    vns_hrv {
        frequency: 25Hz
        intensity: 1.5mA
        hrv_protocol: tavns_sync
        breathing_rate: 6.0
    }

    audio_entrainment {
        isochronic_hz: 40Hz
        noise: pink
        carrier_hz: 440Hz
        volume: 60%
        eeg_adaptive: true
        bone_conduction_pacer: true
    }

    visual_stimulation {
        frequency: 40Hz
        mode: binocular
        emdr_cadence: 1Hz
    }

    tdcs {
        intensity: 1.0mA
        electrode_pairs: [["Fp1", "P3"]]
        ramp: 30s  # hardware-enforced
        interval_on: 20m
        interval_off: 10m
        repeat: 1
    }

}
