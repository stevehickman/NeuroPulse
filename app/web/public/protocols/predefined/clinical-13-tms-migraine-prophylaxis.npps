protocol "TMS — Migraine Prophylaxis (M1)" {
    id: "30000013-0000-0000-0000-000000000000"
    description: "Figure-8 HF rTMS over M1, 10Hz, 600 pulses, for migraine prevention. Grade B."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: ["tms", "clinical", "migraine", "t2"]
    conditions: ["Migraine"]
    references: [["Neuromod protocol database §1 TMS migraine (Grade B)", "docs/neuromod_neuro_protocols.md#1-tms-transcranial-magnetic-stimulation"]]
    duration: 10m

    tms {
        tms_protocol: rTMS
        frequency: 10Hz
        intensity_percent_mt: 85
        target: M1_L
        pulse_count: 600
    }
}
