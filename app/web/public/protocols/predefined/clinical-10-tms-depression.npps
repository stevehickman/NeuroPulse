protocol "TMS — Depression (L-DLPFC 10Hz)" {
    id: "30000010-0000-0000-0000-000000000000"
    description: "Figure-8 rTMS, left DLPFC, 10Hz, 120% RMT, 3000 pulses. FDA-cleared workhorse for MDD. Grade A. 20–30 sessions over 4–6 weeks."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: ["tms", "clinical", "depression", "t2"]
    conditions: ["Major Depressive Disorder"]
    references: [["Neuromod protocol database §1 TMS (Grade A)", "docs/neuromod_neuro_protocols.md#1-tms-transcranial-magnetic-stimulation"], ["O'Reardon 2007; George 2010", "docs/neuromod_neuro_protocols.md"]]
    duration: 37m

    tms {
        tms_protocol: rTMS
        frequency: 10Hz
        intensity_percent_mt: 120
        target: DLPFC_L
        pulse_count: 3000
    }
}
