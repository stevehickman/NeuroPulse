protocol "tACS — Depression (alpha 10Hz)" {
    id: "30000045-0000-0000-0000-000000000000"
    description: "Alpha (10Hz) bifrontal tACS, 2mA, 40 min, 5+ daily sessions, reducing left-frontal alpha. Grade C."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: ["tacs", "alpha", "clinical", "depression"]
    conditions: ["Major Depressive Disorder"]
    references: [["Neuromod protocol database §4 tACS depression (Grade C)", "docs/neuromod_neuro_protocols.md#4-tacs--trns-transcranial-alternating-current-stimulation"], ["Alexander 2019", "docs/neuromod_neuro_protocols.md"]]
    duration: 40m

    bes_tacs {
        frequency: 10Hz
        intensity: 1mA
        waveform: sinusoidal
    }
}
