protocol "TMS — Stroke Motor (contralesional M1)" {
    id: "30000015-0000-0000-0000-000000000000"
    description: "Figure-8 1Hz inhibitory rTMS over contralesional M1, adjunct to rehab. Grade B. 5–10 sessions + rehab."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: ["tms", "clinical", "stroke", "t2"]
    conditions: ["Stroke"]
    references: [["Neuromod protocol database §1 TMS stroke (Grade B)", "docs/neuromod_neuro_protocols.md#1-tms-transcranial-magnetic-stimulation"]]
    duration: 15m

    tms {
        tms_protocol: rTMS
        frequency: 1Hz
        intensity_percent_mt: 100
        target: M1_R
        pulse_count: 1200
    }
}
