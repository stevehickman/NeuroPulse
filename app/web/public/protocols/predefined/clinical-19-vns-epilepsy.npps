protocol "taVNS — Epilepsy" {
    id: "30000019-0000-0000-0000-000000000000"
    description: "Auricular taVNS (cymba conchae), 20–30Hz, ≥1–4 h/day, for epilepsy. Grade B (taVNS) / A (implanted reference). Efficacy accrues over months."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: ["vns", "tavns", "clinical", "epilepsy"]
    conditions: ["Epilepsy"]
    references: [["Neuromod protocol database §2 VNS epilepsy", "docs/neuromod_neuro_protocols.md#2-vns-vagus-nerve-stimulation--all-modalities--indications"], ["Rong 2014", "docs/neuromod_neuro_protocols.md"]]
    duration: 60m

    vns_hrv {
        frequency: 25Hz
        intensity: 1mA
        hrv_protocol: standalone
    }
}
