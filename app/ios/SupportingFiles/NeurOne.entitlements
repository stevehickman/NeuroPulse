<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Background App Refresh + BGTaskScheduler -->
	<key>com.apple.developer.background-modes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<!-- HealthKit intentionally absent — NeurOne never writes to HealthKit.
	     EEG/HRV data stays on-device in the UHDR partition under user-held key. -->
</dict>
</plist>
