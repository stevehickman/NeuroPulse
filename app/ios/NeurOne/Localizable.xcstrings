    "PORTAL_PLEDGE_DISCLAIMER": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pledges are intent only — your card is not charged until a researcher confirms feasibility and a formal campaign activates. If the target is not met, you are never charged."
