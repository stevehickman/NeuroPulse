    "BIPA_STEP1_CARD": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "EEG brainwave patterns are biometric identifiers under Illinois BIPA (740 ILCS 14), special-category personal data under GDPR Article 9, and consumer health data under Washington MHMD. They identify you as uniquely as a fingerprint — and the law requires your explicit authorisation before we can collect them."
          }
        },
