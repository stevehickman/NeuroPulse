    "OTA_ROLLBACK_NOTE": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "If the hub fails to boot after an update, it automatically rolls back to the previous firmware version after 3 failed boot attempts. You can also force USB-C DFU recovery by holding the hub reset button during USB-C connection."
          }
        },
        "bn": {
          "stringUnit": {
