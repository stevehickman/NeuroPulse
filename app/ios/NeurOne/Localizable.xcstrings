    "BIPA_STEP1_BODY_1": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "NeurOne captures electroencephalogram (EEG) data — the faint electrical signals produced when neurons in your brain fire. This data powers real-time neurofeedback and closed-loop stimulation during your sessions."
          }
        },
