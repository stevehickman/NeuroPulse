    "AGE_GATE_SUBTITLE": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "NeurOne collects personal data — including brainwave and heart-rate measurements — to deliver and improve your sessions. Before any data is collected, we need to confirm your age."
