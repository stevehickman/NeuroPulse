    "AGE_GATE_UNDER_16_INFO": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "NeurOne cannot be set up by anyone under 16 years of age. Some features rely on processing health and biometric data, and the law requires you to be at least 16 to provide valid consent. Please ask a parent or guardian for help."
          }
        },
