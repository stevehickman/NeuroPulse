/* =================== BIPA DISCLOSURE (NP-APP-ROADMAP-001 Rev B §9.3) ====== */
/* Illinois biometric written-release disclosure (740 ILCS 14 / BIPA).
   Shown to Illinois users before any EEG biometric data is captured.
   MUST render in full (multi-line, no truncation) per ISC-160.
   Paragraphs separated by blank lines via \n\n. */
"BIPA_DISCLOSURE" = "Illinois residents: please read before continuing.\n\nNeuroPulse collects and stores your electroencephalogram (EEG) brainwave patterns. Under the Illinois Biometric Information Privacy Act (BIPA, 740 ILCS 14), these patterns are biometric identifiers and biometric information.\n\nPurpose: your EEG data is used to deliver and adapt your sessions and to display your own results. It is stored only on your device, encrypted with a key derived from your own biometric or PIN. NeuroPulse cannot read it.\n\nRetention and destruction: your biometric data is retained on your device under your control. It is permanently destroyed when you perform a device factory reset, and in any case within the timeframe set out in our publicly available biometric retention and destruction policy.\n\nNeuroPulse will not sell, lease, trade, or otherwise profit from your biometric information, and will not disclose it without your separate written consent except as required by law.\n\nBy tapping \"I Agree\" you provide your written release to collect and store your biometric data as described above.";

/* BIPA disclosure — affirmative consent button */
"BIPA_AGREE_BUTTON" = "I Agree";

/* BIPA disclosure — screen title */
"BIPA_DISCLOSURE_TITLE" = "Biometric Data Notice";


