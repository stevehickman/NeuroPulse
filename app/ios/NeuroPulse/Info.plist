<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Bluetooth usage descriptions — NeuroPulse hub BLE GATT connection
         (NeuroPulseGATTManager / CBCentralManager). -->
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>NeuroPulse uses Bluetooth to communicate with your NeuroPulse hub in real time.</string>
    <key>NSBluetoothPeripheralUsageDescription</key>
    <string>NeuroPulse uses Bluetooth to communicate with your NeuroPulse hub.</string>

    <!-- HealthKit read usage — HRV during HRV biofeedback sessions, on-device only. -->
    <key>NSHealthShareUsageDescription</key>
    <string>NeuroPulse reads your heart rate variability during HRV biofeedback sessions to display live coherence guidance. This data is never stored or transmitted.</string>

    <!-- Background task identifier for the nightly UHDR backup
         (UHDRBackupScheduler / BGTaskScheduler). -->
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>com.neuropulse.uhdr-backup</string>
    </array>
</dict>
</plist>
