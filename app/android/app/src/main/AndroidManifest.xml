<?xml version="1.0" encoding="utf-8"?>
<!--
  NeurOne Android manifest.

  PRIVACY INVARIANTS (app/android/ISA.md ISC-29, ISC-37):
  - allowBackup="false" + dataExtractionRules: session history, consent state,
    and the opaque SHDR device token must never flow to Google cloud backup or
    device-to-device transfer (parallel of iOS .isExcludedFromBackupKey usage).
  - BLUETOOTH_SCAN carries neverForLocation: the app derives no location from
    BLE scanning, and must not request any location permission.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- BLE (API 31+ runtime permissions). Hub connection is the only use. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Legacy BLE permissions for API 29–30 devices. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- API 29-30 require location for BLE scan results; we gate those devices
         to companion-less mode rather than request location. No ACCESS_FINE_LOCATION
         or ACCESS_COARSE_LOCATION is declared — by design. -->

    <!-- SHDR fleet upload (warranty-owner consent gated) + OTA manifest fetch. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Consumable reminders (measurement-triggered local notifications). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The system prompt that establishes the person's presence before UHDR is readable (NP-APP-PRESENCE-001). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <application
        android:name=".NeurOneApplication"
        android:label="@string/ui_app_title"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:theme="@style/Theme.NeurOne"
        android:supportsRtl="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The system browser returns a cloud sign-in here (SWR-MG-19). Another app can claim the same scheme, so the answer is
                 trusted for nothing: the state value and the PKCE verifier decide it (ExternalBrowserLauncher, CloudAuth). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${cloudAuthRedirectScheme}" />
            </intent-filter>
            <!-- The same, as an https App Link (SWR-MG-25): Google does not take a custom scheme on Android. The system verifies that the domain names
                 this app in /.well-known/assetlinks.json before it hands the link here; until a real host is set the placeholder is a reserved name
                 that never resolves. Same trust as above: the state value and the PKCE verifier decide the answer. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${cloudAuthRedirectHost}" android:pathPrefix="${cloudAuthRedirectPath}" />
            </intent-filter>
        </activity>
    </application>
</manifest>
