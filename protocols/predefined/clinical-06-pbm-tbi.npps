protocol "PBM — TBI (chronic) + Intranasal" {
    id: "30000006-0000-0000-0000-000000000000"
    description: "Multi-site scalp 810nm PBM plus bilateral intranasal for chronic traumatic brain injury / post-concussion syndrome. Grade B. 3x/week, 6+ weeks. Chronic > acute."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: ["pbm", "clinical", "tbi"]
    conditions: ["Traumatic Brain Injury", "Post-Concussion Syndrome"]
    references: [["PBM protocol database §6 (Grade B)", "docs/pbm_neuro_protocols.md#6-traumatic-brain-injury-chronic--post-concussion-syndrome--grade-b"]]
    duration: 18m

    pbm_transcranial {
        intensity: 50%
        frequency: 10Hz
        duty_cycle: 25%
        zones: ["Vault (excl. Occipital)"]
        wavelength: 660_808nm
    }

    pbm_intranasal {
        intensity: 60%
        frequency: 10Hz
        duty_cycle: 25%
    }
}
