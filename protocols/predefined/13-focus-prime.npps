protocol "Focus Prime" {
    id: "1000000D-0000-0000-0000-000000000000"
    description: "20Hz beta/focus protocol combining PBM, closed-loop EEG, BES, binaural audio, and visual entrainment. BES runs in 30-on/30-off intervals for habituation prevention."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: [focus, beta, cognitive, productivity]
    duration: 20m

    pbm_transcranial {
        irradiance_mw_cm2: 322  # was intensity: 80% at 100 % = 403 mW/cm² (OI-HEXTILE-25, 2026-09-25)
        frequency: 20Hz
        duty_cycle: 25%
        zones: ["All"]
        wavelength: "660_808nm"
    }

    eeg_neurofeedback {
        band: beta
        channels: all
        closed_loop: true
    }

    bes_tacs {
        frequency: 20Hz
        intensity: 0.8mA
        waveform: sinusoidal
        interval_on: 30s
        interval_off: 30s
        repeat: until_end
    }

    audio_entrainment {
        binaural_hz: 20Hz
        noise: pink
        carrier_hz: 440Hz
        level_dba: 60  # PROVISIONAL (2026-09-25, every emission absolute): was volume 60% — 60 dBA at the median authored 60 %, % as amplitude; no level evidence in the record (OI-AUDIOHW-01)
        eeg_adaptive: true
        bone_conduction_pacer: false
    }

    visual_stimulation {
        # PROVISIONAL (2026-09-25, every emission absolute): corneal irradiance per lit
        # channel. No level was ever authored; 1 mW/cm² sits under half of IEC 62471's
        # exempt-group IR corneal limit (10 mW/cm² beyond 1,000 s) — CLAUDE.md §3's
        # 50 % rule. The hub refuses until the lens emitters are characterised
        # (OI-VIS-ABS-01).
        irradiance_mw_cm2: 1
        frequency: 20Hz
        mode: binocular
        emdr_cadence: 1Hz
        interval_on: 300s
        interval_off: 120s
        repeat: until_end
    }

}
