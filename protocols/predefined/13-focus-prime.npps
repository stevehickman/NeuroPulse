protocol "Focus Prime" {
    id: "1000000D-0000-0000-0000-000000000000"
    description: "20Hz beta/focus protocol combining PBM, closed-loop EEG, BES, binaural audio, and visual entrainment. BES runs in 30-on/30-off intervals for habituation prevention."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: [focus, beta, cognitive, productivity]
    duration: 20m

    pbm_transcranial {
        intensity: 80%
        frequency: 20Hz
        duty_cycle: 25%
        zones: ["All"]
        wavelength: 660_808nm
    }

    eeg_neurofeedback {
        band: beta
        channels: all
        closed_loop: true
    }

    bes_tacs {
        frequency: 20Hz
        intensity: 0.8mA
        waveform: sinusoidal
        interval_on: 30s
        interval_off: 30s
        repeat: until_end
    }

    audio_entrainment {
        binaural_hz: 20Hz
        noise: pink
        carrier_hz: 440Hz
        volume: 60%
        eeg_adaptive: true
        bone_conduction_pacer: false
    }

    visual_stimulation {
        frequency: 20Hz
        mode: binocular
        emdr_cadence: 1Hz
        interval_on: 300s
        interval_off: 120s
        repeat: until_end
    }

}
