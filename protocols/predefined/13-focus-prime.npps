protocol "Focus Prime" {
    id: "1000000D-0000-0000-0000-000000000000"
    family_id: "449fe64e-1391-4ff5-bb86-a9b6a96a1fc9"
    description: "20Hz beta/focus protocol combining PBM, closed-loop EEG, BES and binaural audio. BES runs in 30-on/30-off intervals for habituation prevention. No visual flicker: the helmet does not drive the goggles between 3 and 60 Hz until it can watch for a seizure response."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: [focus, beta, cognitive, productivity]
    duration: 20m

    # PBM irradiances below are this preset's former percentages restated in mW/cm²:
    # scalp blocks against 403 mW/cm² per channel at full drive (NP-HW-HEXTILE-001
    # §4.3.1), intranasal blocks against a 100 mW/cm² placeholder for a probe that has
    # no specification (OI-ART-04). They are conversions, not evidence-sourced figures
    # (register rows UC-064, UC-065). Each wavelength is its own block, so either
    # can be removed or retuned alone.
    pbm_transcranial {
        wavelength: "660nm"
        irradiance: 322.4mW_cm2
        frequency: 20Hz
        duty_cycle: 25%
        zones: ["All"]
    }
    pbm_transcranial {
        wavelength: "808nm"
        irradiance: 322.4mW_cm2
        frequency: 20Hz
        duty_cycle: 25%
        zones: ["All"]
    }

    eeg_neurofeedback {
        band: beta
        channels: all
        closed_loop: true
    }

    bes_tacs {
        frequency: 20Hz
        intensity: 0.8mA
        waveform: sinusoidal
        interval_on: 30s
        interval_off: 30s
        repeat: until_end
    }

    audio_entrainment {
        binaural_hz: 20Hz
        noise: pink
        carrier_hz: 440Hz
        volume: 70dB  # provisional dB SPL (UC-066)
        eeg_adaptive: true
        bone_conduction_pacer: false
    }

    # No visual_stimulation block (the principal, 2026-11-26, OI-NPPS-LIMITS-01): the goggles
    # refuse photic driving at 3-60 Hz until the Oz photoparoxysmal detector is built and
    # validated (REQ-FWHUB-65, -66; OI-FWHUB-29), and the hub refuses the whole protocol at upload
    # if any block drives inside that zone. The former block drove the goggles at 20 Hz,
    # binocular, 300 s on / 120 s off. It was removed, not retuned to a frequency outside the
    # zone, because no evidence supports the stimulus at another rate. Restore it only by a new
    # ruling once the detector is armed.

}
