protocol "Gamma + Theta Coupled" {
    id: "1000000E-0000-0000-0000-000000000000"
    description: "Simultaneous 40Hz front-zone PBM and 6Hz rear-zone PBM with gamma-theta EEG coupling, binaural + isochronic audio, 40Hz visual entrainment, and BES."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: [focus, gamma, theta, coupled, advanced]
    duration: 20m

    pbm_transcranial {
        irradiance_mw_cm2: 302  # was intensity: 75% at 100 % = 403 mW/cm² (OI-HEXTILE-25, 2026-09-25)
        frequency: 40Hz
        duty_cycle: 25%
        zones: ["Frontal"]
        wavelength: "660_808nm"
    }

    pbm_transcranial {
        irradiance_mw_cm2: 282  # was intensity: 70% at 100 % = 403 mW/cm² (OI-HEXTILE-25, 2026-09-25)
        frequency: 6Hz
        duty_cycle: 25%
        zones: ["Posterior"]
        wavelength: "660_808nm"
    }

    eeg_neurofeedback {
        band: gamma_theta
        channels: all
        closed_loop: true
    }

    audio_entrainment {
        binaural_hz: 40Hz
        isochronic_hz: 6Hz
        noise: pink
        carrier_hz: 440Hz
        level_dba: 60  # PROVISIONAL (2026-09-25, every emission absolute): was volume 60% — 60 dBA at the median authored 60 %, % as amplitude; no level evidence in the record (OI-AUDIOHW-01)
        eeg_adaptive: true
        bone_conduction_pacer: false
    }

    visual_stimulation {
        # PROVISIONAL (2026-09-25, every emission absolute): corneal irradiance per lit
        # channel. No level was ever authored; 1 mW/cm² sits under half of IEC 62471's
        # exempt-group IR corneal limit (10 mW/cm² beyond 1,000 s) — CLAUDE.md §3's
        # 50 % rule. The hub refuses until the lens emitters are characterised
        # (OI-VIS-ABS-01).
        irradiance_mw_cm2: 1
        frequency: 40Hz
        mode: binocular
        emdr_cadence: 1Hz
    }

    bes_tacs {
        frequency: 40Hz
        intensity: 0.8mA
        waveform: sinusoidal
    }

}
