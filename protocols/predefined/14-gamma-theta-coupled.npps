protocol "Gamma + Theta Coupled" {
    id: "1000000E-0000-0000-0000-000000000000"
    family_id: "3a952e64-b1c4-4045-8310-47505327e871"
    description: "Simultaneous 40Hz front-zone PBM and 6Hz rear-zone PBM with gamma-theta EEG coupling, binaural + isochronic audio, and BES. No visual flicker: the helmet does not drive the goggles between 3 and 60 Hz until it can watch for a seizure response."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: [focus, gamma, theta, coupled, advanced]
    duration: 20m

    # PBM irradiances below are this preset's former percentages restated in mW/cm²:
    # scalp blocks against 403 mW/cm² per channel at full drive (NP-HW-HEXTILE-001
    # §4.3.1), intranasal blocks against a 100 mW/cm² placeholder for a probe that has
    # no specification (OI-ART-04). They are conversions, not evidence-sourced figures
    # (register rows UC-064, UC-065). Each wavelength is its own block, so either
    # can be removed or retuned alone.
    pbm_transcranial {
        wavelength: "660nm"
        irradiance: 302.2mW_cm2
        frequency: 40Hz
        duty_cycle: 25%
        zones: ["Frontal"]
    }
    pbm_transcranial {
        wavelength: "808nm"
        irradiance: 302.2mW_cm2
        frequency: 40Hz
        duty_cycle: 25%
        zones: ["Frontal"]
    }

    pbm_transcranial {
        wavelength: "660nm"
        irradiance: 282.1mW_cm2
        frequency: 6Hz
        duty_cycle: 25%
        zones: ["Posterior"]
    }
    pbm_transcranial {
        wavelength: "808nm"
        irradiance: 282.1mW_cm2
        frequency: 6Hz
        duty_cycle: 25%
        zones: ["Posterior"]
    }

    eeg_neurofeedback {
        band: gamma_theta
        channels: all
        closed_loop: true
    }

    audio_entrainment {
        binaural_hz: 40Hz
        isochronic_hz: 6Hz
        noise: pink
        carrier_hz: 440Hz
        volume: 70dB  # provisional dB SPL (UC-066)
        eeg_adaptive: true
        bone_conduction_pacer: false
    }

    # No visual_stimulation block (the principal, 2026-11-26, OI-NPPS-LIMITS-01): the goggles
    # refuse photic driving at 3-60 Hz until the Oz photoparoxysmal detector is built and
    # validated (REQ-FWHUB-65, -66; OI-FWHUB-29), and the hub refuses the whole protocol at upload
    # if any block drives inside that zone. The former block drove the goggles at 40 Hz,
    # binocular, continuous. It was removed, not retuned to a frequency outside the zone, because
    # no evidence supports the stimulus at another rate. Restore it only by a new ruling once the
    # detector is armed.

    bes_tacs {
        frequency: 40Hz
        intensity: 0.8mA
        waveform: sinusoidal
    }

}
