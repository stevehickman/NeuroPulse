protocol "tcVNS — Migraine / Cluster (cervical)" {
    id: "30000026-0000-0000-0000-000000000000"
    description: "T2 cervical accessory (tcVNS), 25Hz in 5kHz bursts, 120s doses, for acute + preventive migraine and cluster headache (gammaCore predicate). Grade A."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: ["vns", "tcvns", "clinical", "migraine", "t2"]
    conditions: ["Migraine", "Cluster Headache"]
    references: [["Neuromod protocol database §2 VNS migraine (Grade A tcVNS)", "docs/neuromod_neuro_protocols.md#2-vns-vagus-nerve-stimulation--all-modalities--indications"], ["gammaCore ACT1/ACT2/PRESTO", "docs/neuromod_neuro_protocols.md"]]
    duration: 2m

    cervical_vns {
        frequency: 25Hz
        intensity: 1.5mA
    }
}
