protocol "taVNS — Anxiety" {
    id: "30000022-0000-0000-0000-000000000000"
    description: "Auricular taVNS (cymba conchae), 20Hz, 4–6mA, 30 min x2/day, 8 weeks, for generalized anxiety. Grade B."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: ["vns", "tavns", "clinical", "anxiety"]
    conditions: ["Generalized Anxiety Disorder"]
    references: [["Neuromod protocol database §2 VNS anxiety (Grade B)", "docs/neuromod_neuro_protocols.md#2-vns-vagus-nerve-stimulation--all-modalities--indications"]]
    duration: 30m

    vns_hrv {
        frequency: 20Hz
        intensity: 1.5mA
        hrv_protocol: standalone
    }
}
