protocol "Gamma Focus" {
    id: "10000001-0000-0000-0000-000000000000"
    description: "Simultaneous 40Hz entrainment across audio, visual, and PBM channels for cognitive enhancement and attention. Evidence-backed GENUS-inspired multi-sensory 40Hz protocol."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: [focus, gamma, 40Hz, cognitive, multimodal]
    conditions: ["Alzheimer's Disease"]
    references: [["PBM Alzheimer's 40Hz (Grade A)", "docs/pbm_neuro_protocols.md#1-alzheimers-disease--dementia--grade-a"], ["tACS 40Hz gamma convergence", "docs/neuromod_neuro_protocols.md"]]
    duration: 20m

    pbm_transcranial {
        irradiance_mw_cm2: 322  # was intensity: 80% at 100 % = 403 mW/cm² (OI-HEXTILE-25, 2026-09-25)
        frequency: 40Hz
        duty_cycle: 25%
        zones: ["Vault (excl. Occipital)"]
        wavelength: "660_808nm"
    }

    audio_entrainment {
        binaural_hz: 40Hz
        noise: none
        carrier_hz: 440Hz
        level_dba: 61  # PROVISIONAL (2026-09-25, every emission absolute): was volume 70% — 60 dBA at the median authored 60 %, % as amplitude; no level evidence in the record (OI-AUDIOHW-01)
        eeg_adaptive: false
        bone_conduction_pacer: false
    }

    visual_stimulation {
        # PROVISIONAL (2026-09-25, every emission absolute): corneal irradiance per lit
        # channel. No level was ever authored; 1 mW/cm² sits under half of IEC 62471's
        # exempt-group IR corneal limit (10 mW/cm² beyond 1,000 s) — CLAUDE.md §3's
        # 50 % rule. The hub refuses until the lens emitters are characterised
        # (OI-VIS-ABS-01).
        irradiance_mw_cm2: 1
        frequency: 40Hz
        mode: binocular
        emdr_cadence: 1Hz
        interval_on: 60s
        interval_off: 30s
        repeat: until_end
    }

    eeg_neurofeedback {
        band: gamma
        channels: all
        closed_loop: true
    }

}
