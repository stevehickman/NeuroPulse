protocol "Gamma Focus" {
    id: "10000001-0000-0000-0000-000000000000"
    family_id: "76445389-393d-494f-bed5-b3e45482e8e6"
    description: "Simultaneous 40Hz entrainment across audio and PBM channels, with gamma-band closed-loop EEG neurofeedback, for focus and attention. No visual flicker: the helmet does not drive the goggles between 3 and 60 Hz until it can watch for a seizure response."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: [focus, gamma, 40Hz, cognitive, multimodal]
    conditions: ["Alzheimer's Disease"]
    references: [["PBM Alzheimer's 40Hz (Grade A)", "docs/pbm_neuro_protocols.md#1-alzheimers-disease--dementia--grade-a"], ["tACS 40Hz gamma convergence", "docs/neuromod_neuro_protocols.md"]]
    duration: 20m

    # PBM irradiances below are this preset's former percentages restated in mW/cm²:
    # scalp blocks against 403 mW/cm² per channel at full drive (NP-HW-HEXTILE-001
    # §4.3.1), intranasal blocks against a 100 mW/cm² placeholder for a probe that has
    # no specification (OI-ART-04). They are conversions, not evidence-sourced figures
    # (register rows UC-064, UC-065). Each wavelength is its own block, so either
    # can be removed or retuned alone.
    pbm_transcranial {
        wavelength: "660nm"
        irradiance: 322.4mW_cm2
        frequency: 40Hz
        duty_cycle: 25%
        zones: ["Vault (excl. Occipital)"]
    }
    pbm_transcranial {
        wavelength: "808nm"
        irradiance: 322.4mW_cm2
        frequency: 40Hz
        duty_cycle: 25%
        zones: ["Vault (excl. Occipital)"]
    }

    audio_entrainment {
        binaural_hz: 40Hz
        noise: none
        carrier_hz: 440Hz
        volume: 75dB  # provisional dB SPL (UC-066)
        eeg_adaptive: false
        bone_conduction_pacer: false
    }

    # No visual_stimulation block (the principal, 2026-11-26, OI-NPPS-LIMITS-01): the goggles
    # refuse photic driving at 3-60 Hz until the Oz photoparoxysmal detector is built and
    # validated (REQ-FWHUB-65, -66; OI-FWHUB-29), and the hub refuses the whole protocol at upload
    # if any block drives inside that zone. The former block drove the goggles at 40 Hz,
    # binocular, 60 s on / 30 s off. It was removed, not retuned to a frequency outside the zone,
    # because no evidence supports the stimulus at another rate. Restore it only by a new ruling
    # once the detector is armed.

    eeg_neurofeedback {
        band: gamma
        channels: all
        closed_loop: true
    }

}
