protocol "Gamma Focus" {
    id: "10000001-0000-0000-0000-000000000000"
    description: "Simultaneous 40Hz entrainment across audio, visual, and PBM channels for cognitive enhancement and attention. Evidence-backed GENUS-inspired multi-sensory 40Hz protocol."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: [focus, gamma, 40Hz, cognitive, multimodal]
    conditions: ["Alzheimer's Disease"]
    references: [["PBM Alzheimer's 40Hz (Grade A)", "docs/pbm_neuro_protocols.md#1-alzheimers-disease--dementia--grade-a"], ["tACS 40Hz gamma convergence", "docs/neuromod_neuro_protocols.md"]]
    duration: 20m

    # PBM irradiances below are this preset's former percentages restated in mW/cm²:
    # scalp blocks against 403 mW/cm² per channel at full drive (NP-HW-HEXTILE-001
    # §4.3.1), intranasal blocks against a 100 mW/cm² placeholder for a probe that has
    # no specification (OI-ART-04). They are conversions, not evidence-sourced figures
    # (register rows UC-064, UC-065). Each wavelength is its own block, so either
    # can be removed or retuned alone.
    pbm_transcranial {
        wavelength: "660nm"
        irradiance: 322.4mW_cm2
        frequency: 40Hz
        duty_cycle: 25%
        zones: ["Vault (excl. Occipital)"]
    }
    pbm_transcranial {
        wavelength: "808nm"
        irradiance: 322.4mW_cm2
        frequency: 40Hz
        duty_cycle: 25%
        zones: ["Vault (excl. Occipital)"]
    }

    audio_entrainment {
        binaural_hz: 40Hz
        noise: none
        carrier_hz: 440Hz
        volume: 75dB  # provisional dB SPL (UC-066)
        eeg_adaptive: false
        bone_conduction_pacer: false
    }

    visual_stimulation {
        frequency: 40Hz
        mode: binocular
        emdr_cadence: 1Hz
        interval_on: 60s
        interval_off: 30s
        repeat: until_end
    }

    eeg_neurofeedback {
        band: gamma
        channels: all
        closed_loop: true
    }

}
