protocol "HRV + taVNS Synchronised" {
    id: "1000000C-0000-0000-0000-000000000000"
    family_id: "616a2f8d-5986-4724-90c2-210d06058884"
    hardware_version: 1
    description: "Stimulation pulses timed to inspiration phase for optimised noradrenergic modulation. Alpha EEG neurofeedback adds cortical awareness layer."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: [HRV, VNS, advanced, synchronised]
    conditions: ["Generalized Anxiety Disorder"]
    references: [["taVNS respiration-gated HRV (Grade B)", "docs/neuromod_neuro_protocols.md"]]
    duration: 20m

    vns_hrv {
        frequency: 25Hz
        intensity: 1.5mA
        hrv_protocol: tavns_sync
        breathing_rate: 6.0
    }

    eeg_neurofeedback {
        band: alpha
        channels: all
        closed_loop: true
    }

}
