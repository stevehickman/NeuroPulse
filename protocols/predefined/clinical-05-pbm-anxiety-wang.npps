protocol "PBM — Anxiety (Wang 2023, high-irradiance pulsed)" {
    id: "30000051-0000-0000-0000-000000000000"
    description: "820nm PBM to the left DLPFC for generalized anxiety, after Wang 2023 (double-blind sham-controlled RCT, n=36): a 2-week course, HAMA reduced vs sham (p=0.021), sustained at 8 weeks. Grade B. Only the wavelength, the site and the course length are confirmed from the source. The irradiance (0.31 W/cm², from the §5 database entry), the mode, the session length and the sessions per week are NOT confirmed, because the full text has not been read; see the block notes."
    author: "NeurOne"
    version: "2.0"
    readonly: true
    tags: ["pbm", "clinical", "anxiety", "dlpfc", "wang2023"]
    conditions: ["Generalized Anxiety Disorder"]
    references: [["Wang 2023, Brain Res Bull, doi:10.1016/j.brainresbull.2023.110682 — double-blind RCT, n=36, 820nm to the left DLPFC, 2-week course, HAMA reduced vs sham (p=0.021), sustained 8 wk. THIS protocol's source trial. Irradiance, session length, schedule and mode unconfirmed.", "docs/pbm_neuro_protocols.md#5-anxiety--gad--grade-b"], ["PBM protocol database §5 — Anxiety / GAD (Grade B), section-level parameter bands (0.03–0.31 W/cm², 10–36 J/cm², 10–20 min)", "docs/pbm_neuro_protocols.md#5-anxiety--gad--grade-b"]]
    duration: 7m

    pbm_transcranial {
        # CONFIRMED from the source: 820nm, left DLPFC. The default wavelength
        # rules deliver 820nm on the 808nm channel alone (NP-NPPS-REF-001 §4.1a).
        wavelength: "820nm"
        zones: ["Frontal Left"]
        # Site fidelity gap: the DLPFC is a few centimetres across, and the
        # finest frontal zone is a 20-socket half-lobe (OI-SESPWR-01, gated on
        # REG-1). The earlier revision lit both frontal half-lobes ("forehead");
        # the trial treated the left side only.

        # UNCONFIRMED — carried from the earlier revision until the paper is
        # read. The mode is not stated in anything read so far. The earlier
        # note that R-4 forced pulsed operation was an inference from the
        # ceiling, not the source, and is withdrawn: if Wang ran CW at 0.31
        # W/cm², this protocol must say so and be refused (CLAUDE.md §3), not
        # be pulsed to fit.
        frequency: 10Hz
        duty_cycle: 25%
        # UNCONFIRMED irradiance: 310 mW/cm² is the §5 database figure. 77% is
        # also PROVISIONAL AS A MAPPING — 310 ÷ 403 against the only stated
        # anchor (NP-HW-HEXTILE-001 §4.3.1), which NP-SES-PWR-001 §2.3 flags
        # as unestablished. Becomes `irradiance_mw_cm2: 310` when confirmed.
        intensity: 77%
        # UNCONFIRMED duration: 7 min is DERIVED, not sourced. At the
        # unconfirmed mode and irradiance above it is the longest exposure
        # inside §5's own 10–36 J/cm² band:
        #   310 mW/cm² × 25% duty = 77.5 mW/cm² average × 420 s = 32.5 J/cm²
        # Replace it with the paper's session length.
    }
}
