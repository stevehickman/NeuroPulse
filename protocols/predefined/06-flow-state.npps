protocol "Flow State" {
    id: "10000006-0000-0000-0000-000000000000"
    description: "Gamma-theta coupled protocol targeting the flow state signature: frontal gamma + parieto-occipital theta. Split-zone PBM with closed-loop EEG adaptation."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: [flow, gamma, theta, performance, creative, multimodal]
    duration: 25m

    pbm_transcranial {
        irradiance_mw_cm2: 322  # was intensity: 80% at 100 % = 403 mW/cm² (OI-HEXTILE-25, 2026-09-25)
        frequency: 40Hz
        duty_cycle: 25%
        zones: ["Frontal"]
        wavelength: "660_808nm"
    }

    pbm_transcranial {
        irradiance_mw_cm2: 302  # was intensity: 75% at 100 % = 403 mW/cm² (OI-HEXTILE-25, 2026-09-25)
        frequency: 6Hz
        duty_cycle: 25%
        zones: ["Posterior"]
        wavelength: "660_808nm"
    }

    eeg_neurofeedback {
        band: gamma_theta
        channels: all
        closed_loop: true
    }

    audio_entrainment {
        binaural_hz: 40Hz
        isochronic_hz: 6Hz
        noise: none
        carrier_hz: 440Hz
        volume: 65%
        eeg_adaptive: true
        bone_conduction_pacer: false
    }

}
