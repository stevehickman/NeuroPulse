protocol "PBM — Autism (pediatric, 40Hz)" {
    id: "30000007-0000-0000-0000-000000000000"
    description: "Low-power 850nm pulsed 40Hz over temporal + posterior sites for pediatric autism spectrum disorder. Grade B. 2x/week, 8 weeks. Conservative pediatric dosing — titrate for tolerability."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: ["pbm", "40Hz", "clinical", "autism", "pediatric"]
    conditions: ["Autism Spectrum Disorder"]
    references: [["PBM protocol database §7 (Grade B)", "docs/pbm_neuro_protocols.md#7-autism-spectrum-disorder-pediatric--grade-b"], ["Fradkin 2024 DB RCT", "docs/pbm_neuro_protocols.md"]]
    duration: 6m

    pbm_transcranial {
        # WAVELENGTH is §7's, "850 nm", exactly. The default wavelength rules
        # window the 808nm channel at 798–840nm, so 850nm is NOT delivered and
        # this protocol is shown as unavailable until the rule is widened
        # (NP-NPPS-REF-001 §7a). It is not moved to the nearest channel. It
        # previously drove 660 and 808nm, neither of which the trial used;
        # that unwanted 660nm dose is gone with the 660_808nm name.
        #
        # IRRADIANCE is NOT in the source: Fradkin 2024 states ≤300 mW total,
        # ~150 mW per emitter. 80.6 mW/cm² is this file's former 20%
        # restated against 403 mW/cm² at full drive (register row UC-064).
        #
        # PEDIATRIC. docs/pbm_neuro_protocols.md §7 calls for "conservative
        # dosing and tolerability titration". Do not raise irradiance or
        # duration here.
        wavelength: "850nm"
        irradiance: 80.6mW_cm2
        frequency: 40Hz
        duty_cycle: 25%
        zones: ["Temporal Left", "Temporal Right"]
    }
}
