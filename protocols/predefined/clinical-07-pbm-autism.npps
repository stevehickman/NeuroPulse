protocol "PBM — Autism (pediatric, 40Hz)" {
    id: "30000007-0000-0000-0000-000000000000"
    description: "Low-power 850nm pulsed 40Hz over temporal + posterior sites for pediatric autism spectrum disorder. Grade B. 2x/week, 8 weeks. Conservative pediatric dosing — titrate for tolerability."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: ["pbm", "40Hz", "clinical", "autism", "pediatric"]
    conditions: ["Autism Spectrum Disorder"]
    references: [["PBM protocol database §7 (Grade B)", "docs/pbm_neuro_protocols.md#7-autism-spectrum-disorder-pediatric--grade-b"], ["Fradkin 2024 DB RCT", "docs/pbm_neuro_protocols.md"]]
    duration: 6m

    pbm_transcranial {
        intensity: 20%
        frequency: 40Hz
        duty_cycle: 25%
        zones: ["Temporal Left", "Temporal Right"]
        wavelength: "660_808nm"
        # NIR-only fidelity gap: the trial used a single NIR wavelength
        # (850nm, Fradkin 2024),
        # and this protocol delivers 660nm alongside it whether or not the
        # evidence did. The constraint is in the LANGUAGE AND COMPILER, not the
        # wire: np_mod_pbm_base_params_t already carries cur_a (660nm) and cur_b
        # (808nm) as separate current registers, but NPPS has one `intensity`
        # field per PBM block with no per-channel form, so hubCompiler.ts
        # writes the same register value into both. The `wavelength` enum also
        # has no 808-only value. Whether the tile's driver supports independent
        # per-channel current is a separate, open question (OI-HEXTILE-07).
        # Unwanted 660nm dose as authored: 7.3 J/cm², 12 % of R-7's 60 J/cm²
        # (NP-FEAS-PBMCH-001 §9.2 — MODELLED on OI-HEXTILE-02's design-target
        # emitters, not measured). Annotation added under OI-PBMCH-06.
        # PEDIATRIC. docs/pbm_neuro_protocols.md §7 calls for "conservative
        # dosing and tolerability titration"; the 660nm this protocol delivers
        # is exposure the source trial did not give a child. Do not raise
        # intensity or duration here before the per-channel form exists.
    }
}
