protocol "PBM — Anxiety (Maiello 2019, low-irradiance CW)" {
    id: "30000005-0000-0000-0000-000000000000"
    description: "Bilateral prefrontal 830nm PBM for generalized anxiety, at the parameters of Maiello 2019 (open-label, n=15): 30 mW/cm² continuous wave, 36 J/cm², 20 min, daily for 8 weeks; SIGH-A 17.3→8.5, d=1.47. Grade B. This is the LOW-IRRADIANCE arm of the §5 evidence — the section's 0.03–0.31 W/cm² band is not a range one protocol occupies, it is two trials an order of magnitude apart, and this is the 0.03 end. See the Wang 2023 protocol for the other."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: ["pbm", "clinical", "anxiety", "cw", "maiello2019"]
    conditions: ["Generalized Anxiety Disorder"]
    references: [["Maiello 2019 — open-label, n=15, 830nm, 30 mW/cm² CW, 36 J/cm², 20 min daily 8 wk, SIGH-A 17.3→8.5 (d=1.47). THIS protocol's source trial.", "docs/pbm_neuro_protocols.md#5-anxiety--gad--grade-b"], ["PBM protocol database §5 — Anxiety / GAD (Grade B), section-level parameter bands", "docs/pbm_neuro_protocols.md#5-anxiety--gad--grade-b"]]
    duration: 20m

    pbm_transcranial {
        # MODE IS DERIVED, NOT ASSUMED. §5 lists "CW or 10 Hz" without saying
        # which Maiello used, but the trial's own numbers settle it:
        #   30 mW/cm² × 1200 s = 36.0 J/cm², exactly the stated dose.
        # At 25% duty the same 20 minutes would deliver 9 J/cm² — below §5's
        # own 10 J/cm² floor. CW is the only mode that closes the arithmetic.
        #
        # 30 mW/cm² is Maiello 2019's stated irradiance, well inside the
        # 200 mW/cm² CW ceiling. The trial used 830nm: one NIR wavelength, so
        # one channel and no 660nm block.
        wavelength: "830nm"
        irradiance: 30mW_cm2
        frequency: 0Hz
        duty_cycle: 25%
        #
        # ⚠ OI-SESPWR-03 BITES HARDEST HERE, and the duty_cycle above is
        # written explicitly SO THAT THE COMMITTED AUDIT CAN SEE IT.
        # scripts/check-pbm-power.ts flags the CW+duty ambiguity only when the
        # field is present in the source; omitting it does not remove the
        # ambiguity — the parser defaults dutyCyclePercent to 25 either way —
        # it only hides it from the check. `frequency: 0Hz` together with a
        # duty_cycle is the undefined case NP-SES-PWR-001 records: the compiler
        # emits freqCode(0) and dutyReg(25) independently and leaves the hub to
        # decide. If CW means full duty this delivers the trial's 36 J/cm²; if
        # the 25% is applied it delivers 9 J/cm², BELOW §5's own 10 J/cm² floor.
        zones: ["Frontal Left", "Frontal Right"]
        # §5 gives "right or bilateral PFC"; Maiello's own laterality is not
        # stated in the source, so the bilateral option is taken and named
        # here rather than silently chosen.
    }
}
