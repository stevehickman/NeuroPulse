protocol "PBM — Alzheimer's (Chun 2026, 808nm high-irradiance)" {
    id: "30000053-0000-0000-0000-000000000000"
    description: "Whole-vault 808nm pulsed PBM for Alzheimer's / dementia at the parameters of Chun 2026 (double-blind, n=26): 0.3 W/cm², 11 min, 72 sessions over 12 weeks; MoCA +3.87 vs −0.74 (p<0.001). Grade A. This is the only §1 trial that states an IRRADIANCE — its companion protocol (Woźniak-Mitał 2026) states total power only, from which no mW/cm² follows."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: ["pbm", "40Hz", "clinical", "alzheimers", "chun2026"]
    conditions: ["Alzheimer's Disease", "Dementia"]
    references: [["Chun 2026 — double-blind, n=26, 808nm, 0.3 W/cm², 4400 J, 11 min, 72 sessions/12 wk, MoCA +3.87 vs −0.74 (p<0.001). THIS protocol's source trial.", "docs/pbm_neuro_protocols.md#1-alzheimers-disease--dementia--grade-a"], ["PBM protocol database §1 — Alzheimer's / dementia (Grade A), section-level bands 0.1–0.3 W/cm², 20–75 J/cm²", "docs/pbm_neuro_protocols.md#1-alzheimers-disease--dementia--grade-a"]]
    duration: 11m

    pbm_transcranial {
        # MODE IS DERIVED. §1 gives "Pulsed 40 Hz ... is the emerging preferred
        # mode; CW is acceptable at 1060 nm" — Chun is 808nm, so CW is not the
        # section's option for it. The dose arithmetic agrees: CW at
        # 300 mW/cm² for 11 min would deliver 198 J/cm², far outside §1's
        # 20–75 J/cm² band, whereas pulsed at 25% duty gives
        #   300 × 25% = 75 mW/cm² × 660 s = 49.5 J/cm² — inside the band.
        frequency: 40Hz
        duty_cycle: 25%
        # TARGET IRRADIANCE: 300 mW/cm² peak (Chun 2026), the top of §1's
        # 0.1–0.3 W/cm² band and inside R-4's 400 mW/cm² pulsed peak ceiling.
        # PROVISIONAL, NOT THE AUTHORED VALUE: 300 ÷ 403 against the only
        # stated anchor (NP-HW-HEXTILE-001 §4.3.1). Becomes
        # `irradiance_mw_cm2: 300`.
        intensity: 74.4%
        zones: ["Vault (excl. Occipital)"]
        # §1: "whole-head (bilateral frontal, temporal, parietal + midline)".
        wavelength: "660_808nm"
        # NIR-only fidelity gap: the trial used a single NIR wavelength. The
        # T1-A base tile drives CH_A (660nm) and CH_B (808nm) from one current
        # register with no channel mask, and the `wavelength` enum has no
        # 808-only value, so 660nm is delivered regardless.
    }
}
