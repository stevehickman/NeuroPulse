protocol "Deep Sleep" {
    id: "10000003-0000-0000-0000-000000000000"
    description: "Slow-wave sleep induction using 2Hz delta PBM on rear zones with brown noise and resonance breathing. Use within 30 minutes of bedtime."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: [sleep, delta, recovery, relaxation]
    conditions: ["Insomnia"]
    references: [["tACS slow-oscillation sleep protocol", "docs/neuromod_neuro_protocols.md#4-tacs--trns-transcranial-alternating-current-stimulation"]]
    duration: 45m

    # PBM irradiances below are this preset's former percentages restated in mW/cm²:
    # scalp blocks against 403 mW/cm² per channel at full drive (NP-HW-HEXTILE-001
    # §4.3.1), intranasal blocks against a 100 mW/cm² placeholder for a probe that has
    # no specification (OI-ART-04). They are conversions, not evidence-sourced figures
    # (register rows UC-064, UC-065). Each wavelength is its own block, so either
    # can be removed or retuned alone.
    pbm_transcranial {
        wavelength: "660nm"
        irradiance: 241.8mW_cm2
        frequency: 2Hz
        duty_cycle: 25%
        zones: ["Posterior"]
    }
    pbm_transcranial {
        wavelength: "808nm"
        irradiance: 241.8mW_cm2
        frequency: 2Hz
        duty_cycle: 25%
        zones: ["Posterior"]
    }

    eeg_neurofeedback {
        band: delta
        channels: all
        closed_loop: true
    }

    audio_entrainment {
        noise: brown
        carrier_hz: 440Hz
        volume: 60dB  # provisional dB SPL (UC-066)
        eeg_adaptive: false
        bone_conduction_pacer: false
    }

    vns_hrv {
        frequency: 6Hz
        intensity: 1.0mA
        hrv_protocol: standalone
        breathing_rate: 5.0
    }

}
