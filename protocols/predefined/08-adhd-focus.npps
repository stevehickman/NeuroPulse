protocol "ADHD Focus" {
    id: "10000008-0000-0000-0000-000000000000"
    description: "EEG neurofeedback theta/beta ratio training with tDCS cortical priming and 20Hz frontal PBM. Based on 21 RCTs (n=1,261) of EEG neurofeedback for ADHD."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: [adhd, focus, theta, beta, neurofeedback, tdcs]
    conditions: ["Attention Deficit Hyperactivity Disorder"]
    references: [["tDCS ADHD (Grade B)", "docs/neuromod_neuro_protocols.md#3-tdcs--hd-tdcs-transcranial-direct-current-stimulation"]]
    duration: 40m

    eeg_neurofeedback {
        band: alpha_theta
        channels: front
        closed_loop: true
    }

    tdcs {
        intensity: 1.5mA
        electrode_pairs: [["F3", "Fp2"]]
        electrode_area_cm2: 35        # OI-CHARGE-04: standard sponge pad, enforced by the safety MCU
        ramp: 30s  # hardware-enforced
        interval_on: 20m
        interval_off: 20m
        repeat: 1
    }

    # PBM irradiances below are this preset's former percentages restated in mW/cm²:
    # scalp blocks against 403 mW/cm² per channel at full drive (NP-HW-HEXTILE-001
    # §4.3.1), intranasal blocks against a 100 mW/cm² placeholder for a probe that has
    # no specification (OI-ART-04). They are conversions, not evidence-sourced figures
    # (register rows UC-064, UC-065). Each wavelength is its own block, so either
    # can be removed or retuned alone.
    pbm_transcranial {
        wavelength: "660nm"
        irradiance: 282.1mW_cm2
        frequency: 20Hz
        duty_cycle: 25%
        zones: ["Frontal"]
    }
    pbm_transcranial {
        wavelength: "808nm"
        irradiance: 282.1mW_cm2
        frequency: 20Hz
        duty_cycle: 25%
        zones: ["Frontal"]
    }

    audio_entrainment {
        isochronic_hz: 20Hz
        noise: none
        carrier_hz: 440Hz
        volume: 67.5dB  # provisional dB SPL (UC-066)
        eeg_adaptive: true
        bone_conduction_pacer: false
    }

}
