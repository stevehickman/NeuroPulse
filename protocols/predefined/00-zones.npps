# NeurOne predefined zones (NP-NPPS Rev B)
# Eight lobe zones matching firmware np_module_map predefined groups
# (np_pgroup_t: L/R x frontal/temporal/parietal/occipital). A zone is a named
# SET OF MODULES resolved against the live module map at run time. Users may
# define their own zones in any .npps file in the protocol directory tree.

zone "Frontal Left" {
    id: "40000001-0000-0000-0000-000000000000"
    description: "Predefined lobe zone — frontal lobe, left hemisphere. Resolves against the live module map."
    lobe: frontal
    side: left
}

zone "Frontal Right" {
    id: "40000002-0000-0000-0000-000000000000"
    description: "Predefined lobe zone — frontal lobe, right hemisphere. Resolves against the live module map."
    lobe: frontal
    side: right
}

zone "Temporal Left" {
    id: "40000003-0000-0000-0000-000000000000"
    description: "Predefined lobe zone — temporal lobe, left hemisphere. Resolves against the live module map."
    lobe: temporal
    side: left
}

zone "Temporal Right" {
    id: "40000004-0000-0000-0000-000000000000"
    description: "Predefined lobe zone — temporal lobe, right hemisphere. Resolves against the live module map."
    lobe: temporal
    side: right
}

zone "Parietal Left" {
    id: "40000005-0000-0000-0000-000000000000"
    description: "Predefined lobe zone — parietal lobe, left hemisphere. Resolves against the live module map."
    lobe: parietal
    side: left
}

zone "Parietal Right" {
    id: "40000006-0000-0000-0000-000000000000"
    description: "Predefined lobe zone — parietal lobe, right hemisphere. Resolves against the live module map."
    lobe: parietal
    side: right
}

zone "Occipital Left" {
    id: "40000007-0000-0000-0000-000000000000"
    description: "Predefined lobe zone — occipital lobe, left hemisphere. Resolves against the live module map."
    lobe: occipital
    side: left
}

zone "Occipital Right" {
    id: "40000008-0000-0000-0000-000000000000"
    description: "Predefined lobe zone — occipital lobe, right hemisphere. Resolves against the live module map."
    lobe: occipital
    side: right
}
