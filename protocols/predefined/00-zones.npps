# NeurOne predefined zones (NP-NPPS Rev B)
# Eight lobe zones (L/R x frontal/temporal/parietal/occipital). A zone is a
# named SET OF MODULES, defined as a list of socket (major) addresses — the
# first half of the two-level (socket:element) scheme (NP-HEX-ZM-001). Listing
# sockets directly makes arbitrary, non-contiguous zones definable. Center-column
# (midline) sockets appear in both the Left and Right zone of their lobe. Users
# may define their own zones in any .npps file in the protocol directory tree.

zone "Frontal Left" {
    id: "40000001-0000-0000-0000-000000000000"
    description: "Predefined lobe zone — frontal lobe, left hemisphere. Socket (major) addresses per the helmet module-address map; midline sockets appear in both hemispheres."
    sockets: [1, 2, 4, 5, 7, 8, 11, 12, 13, 16, 17]
}

zone "Frontal Right" {
    id: "40000002-0000-0000-0000-000000000000"
    description: "Predefined lobe zone — frontal lobe, right hemisphere. Socket (major) addresses per the helmet module-address map; midline sockets appear in both hemispheres."
    sockets: [1, 3, 5, 6, 9, 10, 13, 14, 15, 18, 19]
}

zone "Temporal Left" {
    id: "40000003-0000-0000-0000-000000000000"
    description: "Predefined lobe zone — temporal lobe, left hemisphere. Socket (major) addresses per the helmet module-address map; midline sockets appear in both hemispheres."
    sockets: [20, 29, 38, 47, 56]
}

zone "Temporal Right" {
    id: "40000004-0000-0000-0000-000000000000"
    description: "Predefined lobe zone — temporal lobe, right hemisphere. Socket (major) addresses per the helmet module-address map; midline sockets appear in both hemispheres."
    sockets: [24, 33, 42, 51, 60]
}

zone "Parietal Left" {
    id: "40000005-0000-0000-0000-000000000000"
    description: "Predefined lobe zone — parietal lobe, left hemisphere. Socket (major) addresses per the helmet module-address map; midline sockets appear in both hemispheres."
    sockets: [21, 22, 25, 26, 30, 31, 34, 35, 39, 40, 43, 44, 48, 49, 52, 53, 57, 58]
}

zone "Parietal Right" {
    id: "40000006-0000-0000-0000-000000000000"
    description: "Predefined lobe zone — parietal lobe, right hemisphere. Socket (major) addresses per the helmet module-address map; midline sockets appear in both hemispheres."
    sockets: [22, 23, 27, 28, 31, 32, 36, 37, 40, 41, 45, 46, 49, 50, 54, 55, 58, 59]
}

zone "Occipital Left" {
    id: "40000007-0000-0000-0000-000000000000"
    description: "Predefined lobe zone — occipital lobe, left hemisphere. Socket (major) addresses per the helmet module-address map; midline sockets appear in both hemispheres."
    sockets: [61, 62, 65, 66, 67, 70, 71, 74, 75, 77]
}

zone "Occipital Right" {
    id: "40000008-0000-0000-0000-000000000000"
    description: "Predefined lobe zone — occipital lobe, right hemisphere. Socket (major) addresses per the helmet module-address map; midline sockets appear in both hemispheres."
    sockets: [63, 64, 67, 68, 69, 72, 73, 75, 76, 78]
}
