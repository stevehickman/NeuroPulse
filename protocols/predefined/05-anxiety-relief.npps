protocol "Anxiety Relief" {
    id: "10000005-0000-0000-0000-000000000000"
    description: "Multi-modal anxiety reduction combining VNS, HRV coherence training, alpha PBM, and resonance breathing. Based on 24-RCT meta-analysis (d=0.83 anxiety reduction)."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: [anxiety, stress, hrv, vns, alpha, calm]
    conditions: ["Generalized Anxiety Disorder"]
    references: [["PBM anxiety (Grade B)", "docs/pbm_neuro_protocols.md#5-anxiety--gad--grade-b"], ["taVNS anxiety (Grade B)", "docs/neuromod_neuro_protocols.md"]]
    duration: 20m

    vns_hrv {
        frequency: 25Hz
        intensity: 0.5mA
        hrv_protocol: eeg_biofeedback
        breathing_rate: 6.0
    }

    # PBM irradiances below are this preset's former percentages restated in mW/cm²:
    # scalp blocks against 403 mW/cm² per channel at full drive (NP-HW-HEXTILE-001
    # §4.3.1), intranasal blocks against a 100 mW/cm² placeholder for a probe that has
    # no specification (OI-ART-04). They are conversions, not evidence-sourced figures
    # (register rows UC-064, UC-065). Each wavelength is its own block, so either
    # can be removed or retuned alone.
    pbm_transcranial {
        wavelength: "660nm"
        irradiance: 261.9mW_cm2
        frequency: 10Hz
        duty_cycle: 25%
        zones: ["Frontal"]
    }
    pbm_transcranial {
        wavelength: "808nm"
        irradiance: 261.9mW_cm2
        frequency: 10Hz
        duty_cycle: 25%
        zones: ["Frontal"]
    }

    audio_entrainment {
        binaural_hz: 10Hz
        noise: pink
        carrier_hz: 440Hz
        volume: 70dB  # provisional dB SPL (UC-066)
        eeg_adaptive: true
        bone_conduction_pacer: true
    }

    eeg_neurofeedback {
        band: alpha
        channels: all
        closed_loop: true
    }

}
