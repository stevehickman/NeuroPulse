protocol "taVNS — Insomnia" {
    id: "30000023-0000-0000-0000-000000000000"
    description: "Auricular taVNS (cymba conchae), 20Hz, 30 min x2/day, 8 weeks, improving PSQI. Grade B."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: ["vns", "tavns", "clinical", "insomnia", "sleep"]
    conditions: ["Insomnia"]
    references: [["Neuromod protocol database §2 VNS insomnia (Grade B)", "docs/neuromod_neuro_protocols.md#2-vns-vagus-nerve-stimulation--all-modalities--indications"]]
    duration: 30m

    vns_hrv {
        frequency: 20Hz
        intensity: 1.5mA
        hrv_protocol: standalone
    }
}
