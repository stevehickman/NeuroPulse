composite "Sleep Optimisation Stack" {
    id: "10000101-0000-0000-0000-000000000000"
    description: "Evening stack: alpha wind-down then HRV coherence then deep sleep induction. Runs for approximately 90 minutes starting 2 hours before target sleep time."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: [sleep, evening, "wind-down", delta, alpha, stack]
    conflict_resolution: sequential

    layer "Alpha Calm" {
        start: 0s
        duration: 20m
        intensity_scale: 0.8
    }

    layer "HRV Coherence Training" {
        start: 600s
        duration: 10m
        intensity_scale: 0.7
    }

    layer "Deep Sleep" {
        start: 1200s
        intensity_scale: 1.0
    }

}
