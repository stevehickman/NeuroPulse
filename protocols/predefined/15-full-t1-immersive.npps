protocol "Full T1 Immersive" {
    id: "1000000F-0000-0000-0000-000000000000"
    family_id: "9d2b5837-567e-419d-893e-abb71e8bedd5"
    description: "Seven of the eight T1 modalities running simultaneously with balanced settings. The visual goggles are left out: the helmet does not drive them between 3 and 60 Hz until it can watch for a seizure response. For experienced users. Intranasal PBM and tDCS run in time-limited intervals within the 30-minute session."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: [comprehensive, "all-modalities", advanced, T1]
    duration: 30m

    # PBM irradiances below are this preset's former percentages restated in mW/cm²:
    # scalp blocks against 403 mW/cm² per channel at full drive (NP-HW-HEXTILE-001
    # §4.3.1), intranasal blocks against a 100 mW/cm² placeholder for a probe that has
    # no specification (OI-ART-04). They are conversions, not evidence-sourced figures
    # (register rows UC-064, UC-065). Each wavelength is its own block, so either
    # can be removed or retuned alone.
    pbm_transcranial {
        wavelength: "660nm"
        irradiance: 302.2mW_cm2
        frequency: 40Hz
        duty_cycle: 25%
        zones: ["All"]
    }
    pbm_transcranial {
        wavelength: "808nm"
        irradiance: 302.2mW_cm2
        frequency: 40Hz
        duty_cycle: 25%
        zones: ["All"]
    }

    pbm_intranasal {
        wavelength: "660nm"
        irradiance: 60mW_cm2
        frequency: 40Hz
        duty_cycle: 25%
        interval_on: 15m
        interval_off: 15m
        repeat: 1
    }
    pbm_intranasal {
        wavelength: "808nm"
        irradiance: 60mW_cm2
        frequency: 40Hz
        duty_cycle: 25%
        interval_on: 15m
        interval_off: 15m
        repeat: 1
    }

    eeg_neurofeedback {
        band: gamma
        channels: all
        closed_loop: true
    }

    bes_tacs {
        frequency: 40Hz
        intensity: 0.8mA
        waveform: sinusoidal
    }

    vns_hrv {
        frequency: 25Hz
        intensity: 1.5mA
        hrv_protocol: tavns_sync
        breathing_rate: 6.0
    }

    audio_entrainment {
        isochronic_hz: 40Hz
        noise: pink
        carrier_hz: 440Hz
        volume: 70dB  # provisional dB SPL (UC-066)
        eeg_adaptive: true
        bone_conduction_pacer: true
    }

    # No visual_stimulation block (the principal, 2026-11-26, OI-NPPS-LIMITS-01): the goggles
    # refuse photic driving at 3-60 Hz until the Oz photoparoxysmal detector is built and
    # validated (REQ-FWHUB-65, -66; OI-FWHUB-29), and the hub refuses the whole protocol at upload
    # if any block drives inside that zone. The former block drove the goggles at 40 Hz,
    # binocular, continuous. It was removed, not retuned to a frequency outside the zone, because
    # no evidence supports the stimulus at another rate. Restore it only by a new ruling once the
    # detector is armed.

    tdcs {
        intensity: 1.0mA
        electrode_pairs: [["Fp1", "P3"]]
        electrode_area_cm2: 35        # OI-CHARGE-04: standard sponge pad, enforced by the safety MCU
        ramp: 30s  # hardware-enforced
        interval_on: 20m
        interval_off: 10m
        repeat: 1
    }

}
