protocol "Full T1 Immersive" {
    id: "1000000F-0000-0000-0000-000000000000"
    description: "All 8 T1 modalities running simultaneously with balanced settings. For experienced users. Intranasal PBM and tDCS run in time-limited intervals within the 30-minute session."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: [comprehensive, "all-modalities", advanced, T1]
    duration: 30m

    pbm_transcranial {
        irradiance_mw_cm2: 302  # was intensity: 75% at 100 % = 403 mW/cm² (OI-HEXTILE-25, 2026-09-25)
        frequency: 40Hz
        duty_cycle: 25%
        zones: ["All"]
        wavelength: "660_808nm"
    }

    pbm_intranasal {
        # PROVISIONAL (2026-09-25, every emission absolute): was 60 % of an uncharacterised probe. No intranasal
        # irradiance exists in the evidence record; 100 mW/cm² is the floor of
        # pbm_neuro_protocols.md §1's 40 Hz band (0.1–0.3 W/cm², a SCALP figure).
        # No mucosal ceiling exists (OI-NASAL-02); the hub refuses until the probe
        # is characterised (OI-NASAL-06).
        irradiance_mw_cm2: 100
        frequency: 40Hz
        duty_cycle: 25%
        interval_on: 15m
        interval_off: 15m
        repeat: 1
    }

    eeg_neurofeedback {
        band: gamma
        channels: all
        closed_loop: true
    }

    bes_tacs {
        frequency: 40Hz
        intensity: 0.8mA
        waveform: sinusoidal
    }

    vns_hrv {
        frequency: 25Hz
        intensity: 1.5mA
        hrv_protocol: tavns_sync
        breathing_rate: 6.0
    }

    audio_entrainment {
        isochronic_hz: 40Hz
        noise: pink
        carrier_hz: 440Hz
        level_dba: 60  # PROVISIONAL (2026-09-25, every emission absolute): was volume 60% — 60 dBA at the median authored 60 %, % as amplitude; no level evidence in the record (OI-AUDIOHW-01)
        eeg_adaptive: true
        bone_conduction_pacer: true
    }

    visual_stimulation {
        # PROVISIONAL (2026-09-25, every emission absolute): corneal irradiance per lit
        # channel. No level was ever authored; 1 mW/cm² sits under half of IEC 62471's
        # exempt-group IR corneal limit (10 mW/cm² beyond 1,000 s) — CLAUDE.md §3's
        # 50 % rule. The hub refuses until the lens emitters are characterised
        # (OI-VIS-ABS-01).
        irradiance_mw_cm2: 1
        frequency: 40Hz
        mode: binocular
        emdr_cadence: 1Hz
    }

    tdcs {
        intensity: 1.0mA
        electrode_pairs: [["Fp1", "P3"]]
        electrode_area_cm2: 35        # OI-CHARGE-04: standard sponge pad, enforced by the safety MCU
        ramp: 30s  # hardware-enforced
        interval_on: 20m
        interval_off: 10m
        repeat: 1
    }

}
