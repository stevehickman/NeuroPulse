protocol "taVNS — Migraine Prophylaxis (1Hz)" {
    id: "30000027-0000-0000-0000-000000000000"
    description: "Auricular taVNS (cymba conchae) at 1Hz (note: NOT 25Hz) for migraine prevention — frequency is condition-specific. Grade B. 12 weeks."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: ["vns", "tavns", "clinical", "migraine"]
    conditions: ["Migraine"]
    references: [["Neuromod protocol database §2 VNS migraine taVNS (Grade B, 1Hz)", "docs/neuromod_neuro_protocols.md#2-vns-vagus-nerve-stimulation--all-modalities--indications"], ["Straube 2015", "docs/neuromod_neuro_protocols.md"]]
    duration: 30m

    vns_hrv {
        frequency: 1Hz
        intensity: 1mA
        hrv_protocol: standalone
    }
}
