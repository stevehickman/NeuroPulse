protocol "taVNS + Tones — Tinnitus (paired)" {
    id: "30000028-0000-0000-0000-000000000000"
    description: "Auricular taVNS (25Hz) paired to tailored audio tones to reverse maladaptive auditory plasticity. Grade B/C. Pairing is essential. 6–12 weeks."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: ["vns", "tavns", "audio", "clinical", "tinnitus", "paired"]
    conditions: ["Tinnitus"]
    references: [["Neuromod protocol database §2 VNS tinnitus (Grade B/C paired)", "docs/neuromod_neuro_protocols.md#2-vns-vagus-nerve-stimulation--all-modalities--indications"], ["Tyler 2017", "docs/neuromod_neuro_protocols.md"]]
    duration: 30m

    vns_hrv {
        frequency: 25Hz
        intensity: 0.8mA
        hrv_protocol: standalone
    }

    audio_entrainment {
        isochronic_hz: 8Hz
        noise: none
        carrier_hz: 440Hz
        level_dba: 58  # PROVISIONAL (2026-09-25, every emission absolute): was volume 50% — 60 dBA at the median authored 60 %, % as amplitude; no level evidence in the record (OI-AUDIOHW-01)
        eeg_adaptive: false
        bone_conduction_pacer: false
    }
}
