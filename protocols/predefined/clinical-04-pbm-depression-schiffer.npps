protocol "PBM — Depression (Schiffer 2009, high-irradiance)" {
    id: "30000052-0000-0000-0000-000000000000"
    description: "Single-session 810nm PBM for major depression, as Schiffer 2009 ran it (open pilot, n=10): an LED cluster, continuous wave, 250 mW/cm², 4 min at F3 and then 4 min at F4, 60 J/cm² per site. This is the HIGH-IRRADIANCE arm of the §4 evidence, seven times Cassano 2018; see that protocol for the other end. REFUSED ON THIS HARDWARE TODAY: the validator still caps duty at 25% (OI-HEXTILE-31) and U4 cannot yet conduct CW (OI-HEXTILE-30). It is not reshaped to fit. 250 mW/cm² CW is inside the time-averaged ceiling at 808nm (≈329, CLAUDE.md §3, OI-HEXTILE-32 closed)."
    author: "NeurOne"
    version: "2.0"
    readonly: true
    tags: ["pbm", "clinical", "depression", "dlpfc", "cw", "schiffer2009"]
    conditions: ["Major Depressive Disorder"]
    references: [["Schiffer F et al. 2009, Behav Brain Funct 5:46 — open pilot, n=10, single treatment; 810nm LED cluster, CW, 250 mW/cm², 4 min at F3 then 4 min at F4, 60 J/cm² per site. THIS protocol\'s source.", "docs/pbm_neuro_protocols.md#4-depression-major-depressive-disorder--grade-b"], ["PBM protocol database §4 — Depression (Grade B), section-level bands 0.03–0.25 W/cm², dose target ≥60 J/cm²/site", "docs/pbm_neuro_protocols.md#4-depression-major-depressive-disorder--grade-b"]]
    duration: 8m

    # Two blocks in series, one per site, as the trial ran them. Each wavelength
    # value is the source's own; the default wavelength rules deliver 810nm on
    # the 808nm channel alone (NP-NPPS-REF-001 §4.1a, §7a).
    #
    # Dose check: 250 mW/cm² × 240 s = 60.0 J/cm² per site, the stated dose.
    #
    # Why this is refused, and why it is left refused. CLAUDE.md §3: a PBM
    # ceiling refuses a protocol and never reshapes one. The earlier revision
    # of this file ran 10 Hz at 25% duty for 16 min to keep the dose under the
    # ceiling. That is a different stimulus from the one Schiffer tested, so it
    # is withdrawn. The reference skin limit is adopted in full (OI-HEXTILE-32,
    # closed 2026-09-29), so 250 at 808nm is inside the average term (≈329).
    # What still refuses it: the validator's 25% duty cap (OI-HEXTILE-31), and
    # U4, which cannot yet conduct CW (OI-HEXTILE-30).
    #
    # Site fidelity gap. F3 and F4 are single 10-20 sites. The finest frontal
    # zones are the 20-socket half-lobes, so each block lights far more than
    # its site (OI-SESPWR-01, gated on REG-1).

    pbm_transcranial {
        wavelength: "810nm"
        frequency: 0Hz
        duty_cycle: 100%
        intensity: 62%
        # PROVISIONAL, NOT THE AUTHORED VALUE: 250 ÷ 403 against the only
        # stated anchor (NP-HW-HEXTILE-001 §4.3.1), which NP-SES-PWR-001 §2.3
        # flags as an "if". Becomes `irradiance_mw_cm2: 250`.
        zones: ["Frontal Left"]
        # F3
        interval_on: 4m
        interval_off: 0s
        repeat: 1
    }

    pbm_transcranial {
        wavelength: "810nm"
        frequency: 0Hz
        duty_cycle: 100%
        intensity: 62%
        zones: ["Frontal Right"]
        # F4, after F3
        start: 4m
        interval_on: 4m
        interval_off: 0s
        repeat: 1
    }
}
