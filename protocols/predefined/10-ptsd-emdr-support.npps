protocol "PTSD EMDR Support" {
    id: "1000000A-0000-0000-0000-000000000000"
    description: "EMDR bilateral visual stimulation with VNS vagal support and calming brown noise. Intended for use alongside therapeutic EMDR sessions. WHO-recommended protocol basis."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: [ptsd, emdr, bilateral, trauma, vns, clinical]
    conditions: ["Post-Traumatic Stress Disorder"]
    references: [["TMS PTSD (Grade B)", "docs/neuromod_neuro_protocols.md#1-tms-transcranial-magnetic-stimulation"], ["taVNS PTSD extinction (Grade B)", "docs/neuromod_neuro_protocols.md"]]
    duration: 60m

    visual_stimulation {
        # PROVISIONAL (2026-09-25, every emission absolute): corneal irradiance per lit
        # channel. No level was ever authored; 1 mW/cm² sits under half of IEC 62471's
        # exempt-group IR corneal limit (10 mW/cm² beyond 1,000 s) — CLAUDE.md §3's
        # 50 % rule. The hub refuses until the lens emitters are characterised
        # (OI-VIS-ABS-01).
        irradiance_mw_cm2: 1
        frequency: 1Hz
        mode: emdr
        emdr_cadence: 1Hz
    }

    vns_hrv {
        frequency: 25Hz
        intensity: 0.4mA
        hrv_protocol: standalone
        breathing_rate: 6.0
    }

    audio_entrainment {
        noise: brown
        carrier_hz: 440Hz
        level_dba: 58  # PROVISIONAL (2026-09-25, every emission absolute): was volume 45% — 60 dBA at the median authored 60 %, % as amplitude; no level evidence in the record (OI-AUDIOHW-01)
        eeg_adaptive: false
        bone_conduction_pacer: true
    }

    eeg_neurofeedback {
        band: alpha
        channels: all
        closed_loop: false
    }

}
