protocol "tACS — Working Memory (theta 6Hz)" {
    id: "30000041-0000-0000-0000-000000000000"
    description: "Frontoparietal theta (~6Hz) tACS delivered in-phase to improve working memory (in-phase ↑, anti-phase ↓). Grade A/B — strongest tACS evidence."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: ["tacs", "theta", "clinical", "cognition"]
    conditions: ["Mild Cognitive Impairment"]
    references: [["Neuromod protocol database §4 tACS WM (Grade A/B)", "docs/neuromod_neuro_protocols.md#4-tacs--trns-transcranial-alternating-current-stimulation"], ["Polania 2012; Reinhart 2019", "docs/neuromod_neuro_protocols.md"]]
    duration: 20m

    bes_tacs {
        frequency: 6Hz
        intensity: 1mA
        waveform: sinusoidal
    }
}
