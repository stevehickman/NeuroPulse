protocol "HRV Coherence Training" {
    id: "1000000B-0000-0000-0000-000000000000"
    family_id: "aba80ec3-e974-4bf3-a9b4-cf3aaab821aa"
    hardware_version: 1
    description: "Standalone HRV coherence training with resonance breathing pacer. Bone conduction delivers the breathing cue. Evidence: meta-analysis 24 RCTs (d=0.83 anxiety reduction)."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: [HRV, coherence, stress, relaxation, breathing]
    conditions: ["Generalized Anxiety Disorder"]
    references: [["taVNS autonomic / HRV (Grade B)", "docs/neuromod_neuro_protocols.md"]]
    duration: 20m

    vns_hrv {
        frequency: 25Hz
        intensity: 1.5mA
        hrv_protocol: standalone
        breathing_rate: 6.0
    }

    audio_entrainment {
        noise: pink
        carrier_hz: 440Hz
        volume: 60dB  # provisional dB SPL (UC-066)
        eeg_adaptive: false
        bone_conduction_pacer: true
    }

}
