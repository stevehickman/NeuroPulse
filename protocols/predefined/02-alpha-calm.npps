protocol "Alpha Calm" {
    id: "10000002-0000-0000-0000-000000000000"
    description: "Promotes relaxed alertness via 10Hz alpha entrainment with PBM and HRV biofeedback. Ideal for stress reduction and pre-sleep wind-down."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: [calm, alpha, relaxation, stress, hrv]
    conditions: ["Generalized Anxiety Disorder"]
    references: [["tACS depression/alpha & taVNS anxiety context", "docs/neuromod_neuro_protocols.md"]]
    duration: 20m

    # PBM irradiances below are this preset's former percentages restated in mW/cm²:
    # scalp blocks against 403 mW/cm² per channel at full drive (NP-HW-HEXTILE-001
    # §4.3.1), intranasal blocks against a 100 mW/cm² placeholder for a probe that has
    # no specification (OI-ART-04). They are conversions, not evidence-sourced figures
    # (register rows UC-064, UC-065). Each wavelength is its own block, so either
    # can be removed or retuned alone.
    pbm_transcranial {
        wavelength: "660nm"
        irradiance: 302.2mW_cm2
        frequency: 10Hz
        duty_cycle: 25%
        zones: ["All"]
    }
    pbm_transcranial {
        wavelength: "808nm"
        irradiance: 302.2mW_cm2
        frequency: 10Hz
        duty_cycle: 25%
        zones: ["All"]
    }

    eeg_neurofeedback {
        band: alpha
        channels: all
        closed_loop: true
    }

    vns_hrv {
        frequency: 25Hz
        intensity: 1.5mA
        hrv_protocol: standalone
        breathing_rate: 6.0
    }

    audio_entrainment {
        binaural_hz: 10Hz
        noise: pink
        carrier_hz: 440Hz
        volume: 70dB  # provisional dB SPL (UC-066)
        eeg_adaptive: true
        bone_conduction_pacer: false
    }

}
