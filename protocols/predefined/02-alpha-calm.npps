protocol "Alpha Calm" {
    id: "10000002-0000-0000-0000-000000000000"
    description: "Promotes relaxed alertness via 10Hz alpha entrainment with PBM and HRV biofeedback. Ideal for stress reduction and pre-sleep wind-down."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: [calm, alpha, relaxation, stress, hrv]
    conditions: ["Generalized Anxiety Disorder"]
    references: [["tACS depression/alpha & taVNS anxiety context", "docs/neuromod_neuro_protocols.md"]]
    duration: 20m

    pbm_transcranial {
        irradiance_mw_cm2: 302  # was intensity: 75% at 100 % = 403 mW/cm² (OI-HEXTILE-25, 2026-09-25)
        frequency: 10Hz
        duty_cycle: 25%
        zones: ["All"]
        wavelength: "660_808nm"
    }

    eeg_neurofeedback {
        band: alpha
        channels: all
        closed_loop: true
    }

    vns_hrv {
        frequency: 25Hz
        intensity: 1.5mA
        hrv_protocol: standalone
        breathing_rate: 6.0
    }

    audio_entrainment {
        binaural_hz: 10Hz
        noise: pink
        carrier_hz: 440Hz
        level_dba: 60  # PROVISIONAL (2026-09-25, every emission absolute): was volume 60% — 60 dBA at the median authored 60 %, % as amplitude; no level evidence in the record (OI-AUDIOHW-01)
        eeg_adaptive: true
        bone_conduction_pacer: false
    }

}
