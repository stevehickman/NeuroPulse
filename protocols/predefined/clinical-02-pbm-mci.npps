protocol "PBM — Mild Cognitive Impairment" {
    id: "30000002-0000-0000-0000-000000000000"
    description: "Prefrontal 810nm pulsed 40Hz transcranial PBM for mild cognitive impairment. Grade A. 3–5x/week, 6–12 weeks."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: ["pbm", "40Hz", "clinical", "cognition"]
    conditions: ["Mild Cognitive Impairment"]
    references: [["PBM protocol database §2 (Grade A)", "docs/pbm_neuro_protocols.md#2-mild-cognitive-impairment-mci--grade-a"]]
    duration: 20m

    pbm_transcranial {
        intensity: 30%
        frequency: 40Hz
        duty_cycle: 25%
        zones: ["Frontal Left", "Frontal Right"]
        wavelength: "660_808nm"
    }
}
