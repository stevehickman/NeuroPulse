protocol "Vascular Baseline" {
    id: "10000007-0000-0000-0000-000000000000"
    description: "Continuous-wave PBM for cerebrovascular support. Low-frequency VNS and alpha EEG. Use as a maintenance or recovery session."
    author: "NeurOne"
    version: "1.0"
    readonly: true
    tags: [circulation, CW, baseline, maintenance, cerebrovascular]
    duration: 30m

    # PBM irradiances below are this preset's former percentages restated in mW/cm²:
    # scalp blocks against 403 mW/cm² per channel at full drive (NP-HW-HEXTILE-001
    # §4.3.1), intranasal blocks against a 100 mW/cm² placeholder for a probe that has
    # no specification (OI-ART-04). They are conversions, not evidence-sourced figures
    # (register rows UC-064, UC-065). Each wavelength is its own block, so either
    # can be removed or retuned alone.
    pbm_transcranial {
        wavelength: "660nm"
        irradiance: 322.4mW_cm2
        frequency: 0Hz  # CW
        zones: ["All"]
    }
    pbm_transcranial {
        wavelength: "808nm"
        irradiance: 322.4mW_cm2
        frequency: 0Hz  # CW
        zones: ["All"]
    }

    vns_hrv {
        frequency: 1Hz
        intensity: 1.0mA
        hrv_protocol: standalone
        breathing_rate: 6.0
    }

    eeg_neurofeedback {
        band: alpha
        channels: all
        closed_loop: true
    }

}
