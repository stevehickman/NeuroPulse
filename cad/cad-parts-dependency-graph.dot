/*
 * NeurOne — Mechanical CAD Parts Dependency Graph
 * Companion to: cad/CAD_PARTS_LIST.md
 * Source basis: CLAUDE.md §1-6, docs/np_helmet_geom_001.md, docs/np_hex_zm_001.md,
 *               docs/np_hw_hextile_001.md, docs/np_drv_shell_002.md, docs/np_hw_hub_001.md (Rev C),
 *               docs/np_therm_bezel_001.md, docs/np_hfe_002.md,
 *               docs/reference/durability-maintenance.md,
 *               docs/np_tool_hub_001.md, docs/neurone_tool_shell_001.docx,
 *               docs/neurone_tool_lens_001.docx, docs/np_pwr_budget_001.md,
 *               docs/reference/accessories-roadmap.md
 * Date: 2026-08-10 (rev 2 — re-baselined against origin/main @ e1f8a51)
 *
 * READING THE GRAPH
 *   Edge A -> B means "B's CAD geometry/tooling depends on A" (A must be defined,
 *   locked, or dimensioned first — a mating interface, an offset derivation, or a
 *   retention/tether relationship). The edge label states the reason.
 *
 * ENCODING KEY
 *   SHAPE   = note/doubleoctagon = geometric datum (not a manufactured part)
 *             box3d             = multi-feature structural assembly (its own sub-BOM)
 *             component         = electronic sub-board with a mechanical envelope
 *             box               = single manufactured part / molded feature
 *   BORDER  = solid black  -> part is on the current locked/committed architecture
 *             dashed red   -> [PROVISIONAL] parent document is a design study, gated
 *             dashed grey  -> [RETIRED] architecture deleted; kept as a tombstone so
 *                              older drawings resolve to an explicit retirement
 *   FILL    = light color per subassembly cluster (see cluster labels)
 *
 * NOTE (rev 2): the [ARCH-TRANSITION] border class is retired. Both parts that carried
 *   it are resolved — RIGIDIZER-BOARD favourably (22x14mm fits the 40mm hex with 7mm
 *   margin; cavity is now a standard mould feature), ZONE-PLUG-ANCHOR by supersession.
 *
 * Render: dot -Tsvg cad-parts-dependency-graph.dot -o cad-parts-dependency-graph.svg
 *         dot -Tpng cad-parts-dependency-graph.dot -o cad-parts-dependency-graph.png
 */

digraph NeurOneCADParts {
  rankdir="LR";
  graph [fontname="Helvetica", fontsize=20, labelloc=t, labeljust=l, splines=spline,
         nodesep=0.35, ranksep=0.9, bgcolor="white", compound=true,
         label="NeurOne — Mechanical CAD Parts Dependency Graph (2026-08-10, rev 2)\nA -> B: \"B depends on A\"  |  dashed red border = PROVISIONAL  |  dashed grey border = RETIRED (tombstone)"];
  node  [fontname="Helvetica", fontsize=10, style="filled", margin="0.15,0.10"];
  edge  [fontname="Helvetica", fontsize=8, color="#555555", arrowsize=0.8];

  /* ============================================================ */
  /* DATUM                                                         */
  /* ============================================================ */
  SCALP_SCAN [shape=note, fillcolor="#f0f0f0", color="#333333",
    label="Reference datum:\nscalp/shell LiDAR scan\n(cad/HelmetScan.3dm)\nNOT a manufactured part"];

  /* ============================================================ */
  /* CLUSTER A: HEADSET SHELL / CHASSIS                            */
  /* ============================================================ */
  subgraph cluster_shell {
    label="A. Headset Shell / Chassis (two-nested-bowl)"; style="rounded"; color="#444444"; fontsize=12;

    SHELL_OUTER   [shape=box3d, fillcolor="#cfe2f3", label="SHELL-OUTER\nOuter bowl\n(structural + EMF, L2+L3)"];
    SHELL_INNER   [shape=box3d, fillcolor="#cfe2f3", color="#c0392b", penwidth=2, style="filled,dashed",
      label="SHELL-INNER\nInner bowl\n(module carrier, L1)\n[PROVISIONAL - REG-1]"];
    SOCKET_BODY   [shape=box, fillcolor="#cfe2f3", color="#c0392b", penwidth=2, style="filled,dashed",
      label="SOCKET-BODY (x~80)\nHex socket body\n[PROVISIONAL - REG-1]"];
    BLANK_PLUG    [shape=box, fillcolor="#cfe2f3", label="BLANK-PLUG\nBlanking plug"];
    SOCKET_GASKET [shape=box, fillcolor="#cfe2f3", label="SOCKET-GASKET\nPer-socket LSR gasket land"];
    ELEC_HYDRO_CAP[shape=box, fillcolor="#cfe2f3", label="ELEC-HYDRO-CAP\nElectrode hydration cap\n(tethered)"];
    BEZEL         [shape=box, fillcolor="#cfe2f3",
      label="BEZEL\nSacrificial bezel land\n(optical modules)\nh_b = 1.0mm - DECIDED\n2026-08-11 (principal)\nresidual: BEZEL-1a comfort"];
    CLUSTER_CLAMP [shape=box, fillcolor="#cfe2f3", label="CLUSTER-CLAMP (x18)\nModule cluster clamp\n(lever+plate+plungers)\nCLUSTER-1 / SYM-1 / CONTIG-1"];
    SOCKET_CONTACT[shape=component, fillcolor="#cfe2f3", color="#c0392b", penwidth=2, style="filled,dashed",
      label="SOCKET-CONTACT (x~80)\nSpring-contact (pogo) array\n2.00mm pitch, springs on socket\ncount UNRESOLVED 18/16/14-15\n[OI-HUB-C17]"];
    RIM_LATCH     [shape=box, fillcolor="#cfe2f3", label="RIM-LATCH (x4: AL/AR/PL/PR)\nRim layer-latch\n+ Hall sensor + BeCu fingers"];
    RIM_LABYRINTH [shape=box, fillcolor="#cfe2f3", label="RIM-LABYRINTH\nLabyrinth lip +\nconductive elastomer bead"];
    BLIND_MATE_BOSS[shape=box, fillcolor="#cfe2f3", color="#c0392b", penwidth=2, style="filled,dashed",
      label="BLIND-MATE-BOSS\nPosterior-center connector\nnow ALSO the module interconnect\ncrossing: 4 segregated contact\ngroups, independent returns\n[TIME-BOXED before MECH-1\nOI-SHELL2-02]"];
    FLUXGATE_MOUNT[shape=box, fillcolor="#cfe2f3", label="FLUXGATE-MOUNT\nFluxgate magnetometer\nmount (3-axis)"];
    HELMHOLTZ_FORMER[shape=box, fillcolor="#cfe2f3", label="HELMHOLTZ-FORMER\nHelmholtz coil former\n(3-axis pairs)"];
    TMS_WINDOW    [shape=box, fillcolor="#cfe2f3", label="TMS-WINDOW\nNon-conductive CFRP\nTMS window (T2)"];
    EEG_ROUTE_CHANNEL[shape=box, fillcolor="#e8e8e8", color="#888888", penwidth=2, style="filled,dashed",
      fontcolor="#666666",
      label="EEG-ROUTE-CHANNEL\n[RETIRED - NP-DRV-SHELL-002]\nREQ-ST-01..07 deleted from\nshell tooling; >=15mm separation\nunachievable, <5uVpp retained"];
    ZONE_PLUG_ANCHOR[shape=box, fillcolor="#e8e8e8", color="#888888", penwidth=2, style="filled,dashed",
      fontcolor="#666666",
      label="ZONE-PLUG-ANCHOR\n[RETIRED - superseded by\nBLANK-PLUG / ELEC-HYDRO-CAP;\nNP-HFE-002 retired the\ncolour/tactile keying layer]"];
    PORT_COVER_ANCHOR_SHELL[shape=box, fillcolor="#cfe2f3", label="PORT-COVER-ANCHOR\nAccessory port cover\nanchor post (x3)"];
    TEMPORAL_WING_BOSS[shape=box, fillcolor="#cfe2f3", color="#c0392b", penwidth=2, style="filled,dashed",
      label="TEMPORAL-WING-BOSS (x2)\nMastoid pad anchor boss\n[PROVISIONAL]"];
  }

  /* ============================================================ */
  /* CLUSTER B: FIT SYSTEM                                         */
  /* ============================================================ */
  subgraph cluster_fit {
    label="B. Fit System"; style="rounded"; color="#444444"; fontsize=12;

    BOA_DIAL      [shape=box, fillcolor="#d9ead3", label="BOA-DIAL\nOccipital dial +\nPTFE-lined channel"];
    BOA_CABLE     [shape=box, fillcolor="#d9ead3", label="BOA-CABLE\nReplacement lace + tool"];
    FOREHEAD_BRIDGE[shape=box, fillcolor="#d9ead3", label="FOREHEAD-BRIDGE\n5-position bridge"];
    TEMPORAL_WING [shape=box, fillcolor="#d9ead3", label="TEMPORAL-WING (x2)\nSnap-on stability wing"];
    ELECTRODE_POD [shape=box, fillcolor="#d9ead3", label="ELECTRODE-POD\nSpring-decoupled pod\n(80-120g, +/-12mm)"];
  }

  /* ============================================================ */
  /* CLUSTER C: ZONE MODULES (universal hex-tile)                  */
  /* ============================================================ */
  subgraph cluster_modules {
    label="C. Zone Modules (universal hex-tile, current arch.)"; style="rounded"; color="#444444"; fontsize=12;

    TILE_SHELL    [shape=box3d, fillcolor="#fff2cc", color="#c0392b", penwidth=2, style="filled,dashed",
      label="TILE-SHELL\nUniversal hex-tile mould\n[PROVISIONAL - GATE-1/2]"];
    TILE_T1A      [shape=box, fillcolor="#fff2cc", label="TILE-T1A\nBase PBM population\n(45+45 of 91-site lattice)"];
    TILE_T1B      [shape=box, fillcolor="#fff2cc", color="#c0392b", penwidth=2, style="filled,dashed",
      label="TILE-T1B\nEEG/electrode population\nmasking derivation; ring count\nawaits pod dia. [OI-HEXTILE-05]"];
    TILE_T1C      [shape=box, fillcolor="#fff2cc", label="TILE-T1C\nSmart 1064nm population\n(30+30+30)"];
    TILE_T2D      [shape=box, fillcolor="#fff2cc", label="TILE-T2D\n1170nm deep-PBM laser\n(no successor elec. spec yet)"];
    RIGIDIZER_BOARD[shape=component, fillcolor="#fff2cc",
      label="RIGIDIZER-BOARD\nOn-module driver sub-board\n22x14mm - FITS (13.0 half-diag\nvs 20.0 inradius); cavity is now\na STANDARD mould feature,\nfitted to EVERY tile type"];
    PDMS_WINDOW_TILE[shape=box, fillcolor="#fff2cc", label="PDMS-WINDOW (tile)\nOptical window +\nSiO2 interlayer"];
    AG_AGCL_CONTACT[shape=box, fillcolor="#fff2cc", label="AG-AGCL-CONTACT\nSintered Ag/AgCl\ndual-rated electrode"];
    PD_PAIR_TILE  [shape=box, fillcolor="#fff2cc", label="PD-PAIR (tile)\nPD1 at reserved centre site 0,\nPD2 co-located in XY on the\nscalp-facing layer.\nInGaAs on ALL types (one SKU)"];
  }

  /* ============================================================ */
  /* CLUSTER K: L1 SOCKET INTERCONNECT (NEW rev 2)                 */
  /* ============================================================ */
  subgraph cluster_interconnect {
    label="K. L1 Socket Interconnect (NP-DRV-SHELL-002 / NP-HW-HUB-001 Rev C) — NEW"; style="rounded"; color="#444444"; fontsize=12;

    CLUSTER_CARRIER[shape=box3d, fillcolor="#e6d5f5", color="#c0392b", penwidth=2, style="filled,dashed",
      label="CLUSTER-CARRIER (x18)\nRigid-flex board laminated\ninto L1; every socket <=50mm\nfrom its own carrier.\nLocal MCU? UNRESOLVED\n[OI-HUB-C15 / C17]"];
    CLUSTER_TAIL  [shape=box, fillcolor="#e6d5f5", color="#c0392b", penwidth=2, style="filled,dashed",
      label="CLUSTER-TAIL (x18)\nStatic-only flex, formed once.\n>=12.5mm static bend radius;\nno bend within 5mm of a\ntransition, under a clamp plate,\nor under a socket"];
    PAN           [shape=box3d, fillcolor="#e6d5f5", color="#c0392b", penwidth=2, style="filled,dashed",
      label="PAN\nPosterior aggregation node\n(occiput centreline, on L1).\nADS1299 bank here or on the\nHub PCB? [OI-SHELL2-10]"];
    N1_BUS_PAIR   [shape=box, fillcolor="#e6d5f5", color="#c0392b", penwidth=2, style="filled,dashed",
      label="N1-BUS-PAIR\nVLED/PGND broadside pair,\ndielectric <=0.2mm, loop area\n<=25mm^2 per cluster feed.\nTREE from PAN, never a ring.\nNO return via shell/shield/DRL"];
    N4_GUARD_LANE [shape=box, fillcolor="#e6d5f5", color="#c0392b", penwidth=2, style="filled,dashed",
      label="N4-GUARD-LANE (8 T1 / ~21 T2)\nElectrode lanes under a DRL\nguard on L1's scalp-facing face.\nSized by channel count,\nnot socket count"];
  }

  /* ============================================================ */
  /* CLUSTER D: CONTROL HUB ENCLOSURE                              */
  /* ============================================================ */
  subgraph cluster_hub {
    label="D. Control Hub Enclosure"; style="rounded"; color="#444444"; fontsize=12;

    HUB_HOUSING   [shape=box3d, fillcolor="#f4cccc", label="HUB-HOUSING\nHub enclosure housing"];
    PROBE_DOCK    [shape=box, fillcolor="#f4cccc", label="PROBE-DOCK\nIntranasal probe dock"];
    PROBE_DOCK_PAD[shape=box, fillcolor="#f4cccc", label="PROBE-DOCK-PAD (x2)\nSilicone insert pad"];
    PORT_COVER_HUB[shape=box, fillcolor="#f4cccc", label="PORT-COVER (hub, x2)\nUSB-C / DFU port cover"];
    HUB_CHANNEL   [shape=box, fillcolor="#f4cccc", label="HUB-CHANNEL\nBoa channel continuation"];
    FAN_DOOR      [shape=box, fillcolor="#f4cccc", label="FAN-DOOR\nTool-free access door"];
    HEATSINK_ASSY [shape=box, fillcolor="#f4cccc", label="HEATSINK-ASSY\nFan-cooled heatsink"];
    SUPERCAP_MOUNT[shape=box, fillcolor="#f4cccc", label="SUPERCAP-MOUNT\n22F supercap retention"];
  }

  /* ============================================================ */
  /* CLUSTER E: VISUAL STIMULATION (GOGGLE)                        */
  /* ============================================================ */
  subgraph cluster_goggle {
    label="E. Visual Stimulation (Goggle)"; style="rounded"; color="#444444"; fontsize=12;

    LENS_RIM      [shape=box3d, fillcolor="#d0e0e3", label="LENS-RIM\nLens rim body\n(standard + EC)"];
    GOGGLE_ARM    [shape=box3d, fillcolor="#d0e0e3", label="GOGGLE-ARM (x2)\nGoggle arm body"];
    LENS_SUBSTRATE[shape=box, fillcolor="#d0e0e3", label="LENS-SUBSTRATE\nAgNW + hard coat +\nPDMS diffuser + micro-LEDs"];
    SHADE_S1      [shape=box, fillcolor="#d0e0e3", label="SHADE-S1\nOpaque shade (<0.5% VLT)"];
    SHADE_S2      [shape=box, fillcolor="#d0e0e3", label="SHADE-S2\nPolarizing shade (~12% VLT)"];
    SHADE_S3_CARRIER[shape=box, fillcolor="#d0e0e3", label="SHADE-S3-CARRIER\nPrescription clip carrier"];
    S3_RX_INSERT  [shape=box, fillcolor="#d0e0e3", label="S3-RX-INSERT\nOptician-fitted Rx insert"];
    LENS_RIM_GUARD[shape=box, fillcolor="#d0e0e3", label="LENS-RIM-GUARD\nTethered TPU rim guard"];
    GOGGLE_PROXIMITY[shape=box, fillcolor="#d0e0e3", label="GOGGLE-PROXIMITY\nIR proximity + Hall\nlift-cutoff sensor mount"];
  }

  /* ============================================================ */
  /* CLUSTER F: NEURAL AUDIO ENTRAINMENT                           */
  /* ============================================================ */
  subgraph cluster_audio {
    label="F. Neural Audio Entrainment"; style="rounded"; color="#444444"; fontsize=12;

    EARCUP_HOUSING[shape=box3d, fillcolor="#ead1dc", label="EARCUP-HOUSING (x2)\nOver-ear cup housing"];
    BAYONET_MOUNT [shape=box, fillcolor="#ead1dc", label="BAYONET-MOUNT (x2)\nAluminium bayonet mount"];
    MESH_FRAME    [shape=box, fillcolor="#ead1dc", label="MESH-FRAME (x2)\nSnap-in mesh frame"];
    BONECONDUCT_ISOLATOR[shape=box, fillcolor="#ead1dc", label="BONECONDUCT-ISOLATOR (x2)\nPiezo silicone isolator"];
  }

  /* ============================================================ */
  /* CLUSTER G: PBM INTRANASAL PROBE                               */
  /* ============================================================ */
  subgraph cluster_intranasal {
    label="G. PBM Intranasal Probe"; style="rounded"; color="#444444"; fontsize=12;

    PROBE_BODY    [shape=box3d, fillcolor="#fce5cd", label="PROBE-BODY\nBilateral Y-probe body"];
    PROBE_DEPTH_RING[shape=box, fillcolor="#fce5cd", label="PROBE-DEPTH-RING\nDepth-stop ring set\n(15/20/25mm)"];
    PROBE_TIP_SENSOR[shape=box, fillcolor="#fce5cd", label="PROBE-TIP-SENSOR (x2)\nPhotodiode + auth\nsleeve housing"];
    PROBE_SLEEVE  [shape=box, fillcolor="#fce5cd", label="PROBE-SLEEVE\nHygiene sleeve\n(consumable, 30-pack)"];
  }

  /* ============================================================ */
  /* CLUSTER H: VNS + HRV AURICULAR CLIP                           */
  /* ============================================================ */
  subgraph cluster_vns {
    label="H. VNS + HRV Auricular Clip"; style="rounded"; color="#444444"; fontsize=12;

    CLIP_BODY     [shape=box3d, fillcolor="#c9daf8", label="CLIP-BODY\nAuricular clip body"];
    CLIP_HYDROGEL_INTERFACE[shape=box, fillcolor="#c9daf8", label="CLIP-HYDROGEL-INTERFACE\nPDMS hydrogel pad interface"];
    CLIP_A1A2_CONTACT[shape=box, fillcolor="#c9daf8", label="CLIP-A1A2-CONTACT (x2)\nA1/A2 EEG reference contact"];
  }

  /* ============================================================ */
  /* CLUSTER I: T2-ONLY ACCESSORIES                                */
  /* ============================================================ */
  subgraph cluster_t2 {
    label="I. T2-Only Accessories (non-tile)"; style="rounded"; color="#444444"; fontsize=12;

    TMS_COIL_HOUSING[shape=box, fillcolor="#d9d2e9", color="#c0392b", penwidth=2, style="filled,dashed",
      label="TMS-COIL-HOUSING\nFocal figure-8 coil housing\nCANNOT BE SIZED: TMS has NO\nelectrical spec anywhere; est.\n~15-400W, never in T2-peak\n[OI-PWR-04]"];
    CVNS_NECKBAND [shape=box3d, fillcolor="#d9d2e9", label="CVNS-NECKBAND\nCervical VNS neckband"];
    CVNS_GEL_ELECTRODE_HOUSING[shape=box, fillcolor="#d9d2e9", label="CVNS-GEL-ELECTRODE-HOUSING (x2)\nGel electrode housing"];
    QEEG21_CAP_ELECTRODE[shape=box, fillcolor="#d9d2e9", label="QEEG21-CAP-ELECTRODE (x21)\nWet-gel cap electrode housing"];
  }

  /* ============================================================ */
  /* CLUSTER J: PACKAGING / SERVICE                                */
  /* ============================================================ */
  subgraph cluster_pkg {
    label="J. Packaging / Service"; style="rounded"; color="#444444"; fontsize=12;

    CASE_CLAMSHELL[shape=box, fillcolor="#efefef", label="CASE-CLAMSHELL\nHard clamshell case"];
    CABLE_USBC    [shape=box, fillcolor="#efefef", label="CABLE-USBC\nBraided aramid cable +\nstrain relief"];
    BOA_REGREASE_KIT[shape=box, fillcolor="#efefef", label="BOA-REGREASE-KIT\nRegrease applicator"];
  }

  /* Accessories (provisional, informs shell tooling but ships separately) */
  MASTOID_PAD_CLIP [shape=box, fillcolor="#f9cb9c", color="#c0392b", penwidth=2, style="filled,dashed",
    label="Mastoid LRA pad clip\n(accessory)\n[PROVISIONAL - HOPE Ph.3]"];

  /* ============================================================ */
  /* EDGES                                                         */
  /* ============================================================ */

  SCALP_SCAN -> SHELL_INNER [label="scan-grounded scalp datum offset outward defines the inner-bowl tiling surface (REG-1 basis)"];

  SHELL_INNER -> SOCKET_BODY [label="~80-socket lattice is a molded feature array of the inner bowl"];
  SOCKET_BODY -> TILE_SHELL [label="module footprint must mate socket cutout (40mm hex, orientation key)"];
  SOCKET_BODY -> SOCKET_CONTACT [label="spring-contact array seats in the socket floor; pad pattern asymmetric so a mis-key fails OPEN, not wrong"];
  SOCKET_CONTACT -> TILE_SHELL [label="tile presents a flat gold PAD ARRAY on its back face - no FPC tail, no dynamic flex anywhere in the module interconnect"];
  SOCKET_CONTACT -> CLUSTER_CLAMP [label="contact count x0.3-0.5N sets clamp-plate load (18/16/14 contacts = 63/56/49N per 7-tile plate) against RISK-22 one-handed force (OI-SHELL2-03)"];
  SOCKET_BODY -> BLANK_PLUG [label="blanking plug shares the identical hex footprint as a live module"];
  SOCKET_BODY -> SOCKET_GASKET [label="gasket land is co-molded to the socket rim"];
  SOCKET_BODY -> BEZEL [label="bezel land is molded at the socket rim, proud of optical module faces only"];
  BEZEL -> ELECTRODE_POD [label="at h_b=1.0mm the bezel consumes 8% of the pod's +/-12mm one-sided travel; electrode aperture stays bezel-free (BEZEL-1b)"];
  BEZEL -> HEATSINK_ASSY [label="h_b sets R_gap=s/k_air: at 1.0mm (0.0385) the forced outward path (0.010-0.040) is the preferred sink; at 0.6mm (0.0231) the scalp competes - the bezel is what lets the fan do the work"];
  BEZEL -> TILE_T1A [label="h_b sets the active field: W_a=38.0mm, A_a=12.51cm2 (+17.9% vs the 2.5mm assumption), so per-channel E falls 403->342 mW/cm2 at 150mA and needs ~176mA to reach the 400 ceiling"];

  TILE_SHELL -> TILE_T1A [label="element-population variant on the shared tile mould"];
  TILE_SHELL -> TILE_T1B [label="element-population variant on the shared tile mould"];
  TILE_SHELL -> TILE_T1C [label="element-population variant on the shared tile mould"];
  TILE_SHELL -> TILE_T2D [label="element-population variant on the shared tile mould"];
  TILE_T1A -> PDMS_WINDOW_TILE [label="optical tile requires bonded PDMS window over LED array"];
  TILE_T1C -> PDMS_WINDOW_TILE [label="optical tile requires bonded PDMS window over LED array"];
  TILE_T2D -> PDMS_WINDOW_TILE [label="optical tile requires bonded PDMS window over LED array"];
  TILE_T1B -> AG_AGCL_CONTACT [label="electrode tile carries the dual-rated Ag/AgCl contact in place of a full LED window"];
  TILE_T1A -> PD_PAIR_TILE [label="dose metering requires PD1/PD2 pair behind the window"];
  TILE_T1C -> PD_PAIR_TILE [label="dose metering requires PD1/PD2 pair (InGaAs variant) behind the window"];
  TILE_SHELL -> RIGIDIZER_BOARD [label="rigidizer cavity is a STANDARD feature of the universal mould - every tile type carries a driver (D-3), so there is no smart-module mould variant"];
  TILE_T1B -> PD_PAIR_TILE [label="electrode tile still meters its own reduced PBM population"];
  ELECTRODE_POD -> TILE_T1B [label="REVERSED rev 2: the pod BODY DIAMETER (unspecified anywhere, OI-HEXTILE-05) decides how many emitter rings T1-B depopulates - 0-1/0-2/0-3 opens 7.6/15.2/22.8mm clear"];
  TILE_T1B -> QEEG21_CAP_ELECTRODE [label="qEEG-21 electrode reuses T1-B's dual-rated Ag/AgCl mechanical family at higher density"];

  SHELL_INNER -> CLUSTER_CLAMP [label="clamp actuator mounts on the inner bowl's outer (gap-facing) face, one per 7-hex flower"];
  CLUSTER_CLAMP -> TILE_SHELL [label="clamp plate's spring-loaded plungers seat and retain each module in the cluster"];
  SHELL_OUTER -> RIM_LATCH [label="four-corner latch clamps outer bowl to inner bowl at the rim parting plane"];
  SHELL_INNER -> RIM_LATCH [label="latch also engages the inner bowl rim (both bowls clamp together for use)"];
  RIM_LATCH -> RIM_LABYRINTH [label="latch clamping force compresses the labyrinth lip + conductive bead seal"];
  RIM_LATCH -> BLIND_MATE_BOSS [label="flanking PL/PR latches seat the posterior-center blind-mate boss as bowls close"];
  SHELL_INNER -> FLUXGATE_MOUNT [label="fluxgate magnetometers mount on the inner bowl, near the scalp"];
  SHELL_OUTER -> HELMHOLTZ_FORMER [label="Helmholtz coil formers are co-designed as one magnetic circuit with the outer bowl's mu-metal layer"];
  FLUXGATE_MOUNT -> BLIND_MATE_BOSS [label="fluxgate sensor harness crosses the parting plane via the blind-mate boss"];
  HELMHOLTZ_FORMER -> BLIND_MATE_BOSS [label="Helmholtz coil harness crosses the parting plane via the blind-mate boss"];
  SHELL_OUTER -> TMS_WINDOW [label="TMS window is a local non-conductive break in the outer bowl's CFRP layer"];
  TMS_WINDOW -> TMS_COIL_HOUSING [label="coil housing mates directly over the non-conductive window to avoid eddy-current field loss"];
  SHELL_OUTER -> EEG_ROUTE_CHANNEL [style=dotted, color="#aaaaaa", fontcolor="#888888", label="RETIRED: there is no zone-module FPC bundle to route opposite, and no separate EEG harness"];
  EEG_ROUTE_CHANNEL -> N4_GUARD_LANE [style=dashed, color="#888888", fontcolor="#666666", label="SUCCESSOR: the <5uVpp threshold survives (SH2-DRC-16); it is now met by guarding + short analog paths + deterministic artifact, not by >=15mm of geometry"];
  SHELL_OUTER -> ZONE_PLUG_ANCHOR [style=dotted, color="#aaaaaa", fontcolor="#888888", label="RETIRED: 5-zone colour-coded tether scheme superseded"];
  SHELL_OUTER -> PORT_COVER_ANCHOR_SHELL [label="anchor post is molded adjacent to each hub port opening on the shell/hub boundary"];
  PORT_COVER_ANCHOR_SHELL -> PORT_COVER_HUB [label="tether anchor retains the port cover when detached"];
  TEMPORAL_WING -> TEMPORAL_WING_BOSS [label="anchor boss is an integral molded feature of the temporal wing body"];
  TEMPORAL_WING_BOSS -> MASTOID_PAD_CLIP [label="30mm receiver + snap-detent geometry sets the mating pad clip's required dimensions"];

  BOA_DIAL -> BOA_CABLE [label="replacement lace is dimensioned to the dial's channel cross-section and OD"];
  BOA_DIAL -> HUB_CHANNEL [label="Boa channel must continue without cross-section discontinuity from shell into hub housing"];
  BOA_DIAL -> BOA_REGREASE_KIT [label="regrease applicator nozzle is sized to the dial's grease port"];

  HUB_HOUSING -> PROBE_DOCK [label="probe dock cradle is a molded feature of the hub housing exterior"];
  PROBE_DOCK -> PROBE_DOCK_PAD [label="silicone insert pad bonds into each probe-tip receptacle of the dock"];
  PROBE_BODY -> PROBE_DOCK [label="dock saddle radius is sized to the Y-probe junction body OD, not the lead OD"];
  PROBE_TIP_SENSOR -> PROBE_DOCK_PAD [label="dock pad geometry protects the probe-tip PD window and auth contacts in storage"];
  HUB_HOUSING -> FAN_DOOR [label="access door is a molded cutout + captive-fastener bosses in the hub housing"];
  FAN_DOOR -> HEATSINK_ASSY [label="door provides tool-free clearing access to the fan/heatsink cavity behind it"];
  HEATSINK_ASSY -> PORT_COVER_HUB [label="port-cover tether length is bounded so a detached cover cannot reach the fan intake grille (FAI-HTOOL-02)"];
  HUB_HOUSING -> SUPERCAP_MOUNT [label="supercap mount is an internal retention feature of the hub housing"];
  SHELL_OUTER -> HUB_HOUSING [label="hub-to-shell mechanical interface, cable entry, and EMI bonding depend on shell rim geometry at the occipital arch (OI-HTOOL-01, open)"];
  CABLE_USBC -> HUB_HOUSING [label="strain-relief boot geometry mates to the hub's USB-C port opening"];

  LENS_RIM -> GOGGLE_ARM [label="sliding-rail T-slot (rim) and mating tongue (arm) are co-reviewed as one mating pair"];
  GOGGLE_ARM -> LENS_RIM [label="EC driver spring pins (arm) must align with EC contact pads (rim) - EC configuration only"];
  LENS_RIM -> LENS_SUBSTRATE [label="lens substrate seats in the lens rim's optical aperture"];
  LENS_RIM -> SHADE_S1 [label="6 N42 magnet pockets in the rim must align with the shade's reversed-polarity mating pockets"];
  LENS_RIM -> SHADE_S2 [label="same magnet-pocket mating pattern as S1"];
  LENS_RIM -> SHADE_S3_CARRIER [label="same magnet-pocket mating pattern as S1/S2"];
  SHADE_S3_CARRIER -> S3_RX_INSERT [label="optician-fitted insert mounts into the carrier's optical aperture"];
  GOGGLE_ARM -> LENS_RIM_GUARD [label="tether anchor hook on the arm retains the rim guard, clear of the shade body and visual field"];
  LENS_SUBSTRATE -> GOGGLE_PROXIMITY [label="IR proximity + Hall sensor mounts are positioned relative to the substrate's eye-facing aperture"];

  SHELL_OUTER -> EARCUP_HOUSING [label="ear-cup subassembly mounts to the outer-bowl (L3) rim at the ear cutout excluded from the tile lattice"];
  EARCUP_HOUSING -> BAYONET_MOUNT [label="bayonet mount is an integral feature of the ear-cup housing"];
  BAYONET_MOUNT -> MESH_FRAME [label="mesh frame snaps into the bayonet mount"];
  EARCUP_HOUSING -> BONECONDUCT_ISOLATOR [label="isolator mounts the bone-conduction piezo element within the ear-cup housing"];

  PROBE_BODY -> PROBE_DEPTH_RING [label="depth-stop rings are over-molded onto the probe shaft"];
  PROBE_BODY -> PROBE_TIP_SENSOR [label="tip sensor housing terminates each bilateral probe arm"];
  PROBE_TIP_SENSOR -> PROBE_SLEEVE [label="consumable hygiene sleeve fits over the tip sensor housing"];
  PROBE_BODY -> CASE_CLAMSHELL [label="case includes its own transport probe-dock cavity, distinct from the hub's active-storage dock"];

  CLIP_BODY -> CLIP_HYDROGEL_INTERFACE [label="hydrogel pad interface geometry is molded into the clip's contact face"];
  CLIP_BODY -> CLIP_A1A2_CONTACT [label="A1/A2 contacts reuse 2 spare conductors already present in the clip's 6-pin cable"];

  CVNS_NECKBAND -> CVNS_GEL_ELECTRODE_HOUSING [label="gel electrode housings mount bilaterally on the neckband body"];

  TILE_SHELL -> CASE_CLAMSHELL [label="case's internal cavity profile is fitted to the assembled headset + module envelope"];

  /* ---- K: L1 socket interconnect (new rev 2) ---- */
  SHELL_INNER -> CLUSTER_CARRIER [label="carriers are LAMINATED INTO L1 - the inner bowl stops being a molded part and becomes an electro-mechanical assembly (new supplier CAT, OI-SHELL2-04)"];
  CLUSTER_CARRIER -> SOCKET_CONTACT [label="carrier hosts its cluster's contact arrays; every socket must sit <=50mm from its own carrier (SH2-DRC-03) - the whole reason the analog front end moved here"];
  CLUSTER_CLAMP -> CLUSTER_CARRIER [label="MUST STAY SEPARATE PARTS on opposite faces of the same cluster footprint: if the carrier were the plate, every module swap would cycle a whole cluster's electrical connection"];
  CLUSTER_CARRIER -> CLUSTER_TAIL [label="one tail per carrier, formed once at assembly"];
  CLUSTER_CLAMP -> CLUSTER_TAIL [label="no formed bend may fall under a clamp-plate footprint or under a socket, so clamp load never bears on a bend (REQ-BR2-05)"];
  CLUSTER_TAIL -> PAN [label="all 18 tails converge at the occiput centreline"];
  PAN -> BLIND_MATE_BOSS [label="PAN is co-sited with the boss; the module interconnect SHARES the existing aperture rather than opening a second RF slot"];
  CLUSTER_CARRIER -> N1_BUS_PAIR [label="cluster power gate feeds the broadside supply pair"];
  CLUSTER_CARRIER -> N4_GUARD_LANE [label="per-cluster analog mux drops the montage onto the shared guarded lanes"];
  N4_GUARD_LANE -> AG_AGCL_CONTACT [label="the one contact pair on which <=50mohm and fretting are genuinely binding - it sits in the uV EEG path (OI-HEXTILE-11)"];
  N1_BUS_PAIR -> FLUXGATE_MOUNT [label="the LED bus is an ELF dB/dt source on the fluxgates' own layer: cancellation calibration becomes configuration-dependent and must re-run on module-map rebuild (REQ-EMI-11)"];
  N1_BUS_PAIR -> HELMHOLTZ_FORMER [label="feed-forward self-field subtraction must bind to MEASURED PD/dose telemetry, not commanded current (REQ-EMI-05)"];
  HEATSINK_ASSY -> RIGIDIZER_BOARD [label="whether the TIA+ADC stay on-module (D-4) is deferred pending the module heat-sink / helmet-cooling design - 42C face / 62C junction, plus ADC drift vs the +/-15% dose claim (OI-HUB-C17c)"];
  HEATSINK_ASSY -> SOCKET_CONTACT [label="and the socket contact count is blocked behind that same decision"];
  BLANK_PLUG -> CASE_CLAMSHELL [label="partial-population option (~6 concurrent tiles, ~$920 to fill 80 sockets) may put 50-60 plugs in a build - OI-HEXTILE-06 sizes both the plug tool and the packaging"];

}
