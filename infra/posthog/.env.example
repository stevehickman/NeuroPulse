# NeurOne PostHog — Environment Configuration Template
# NP-ANALYTICS-001 Rev A
#
# Usage:
#   cp .env.example .env
#   Fill in all required values below (marked with [REQUIRED])
#   Never commit .env to git — it is listed in .gitignore

# ── Required secrets ─────────────────────────────────────────────────────────

# Django secret key. Generate once and keep stable.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# PostgreSQL password. Use a strong random value.
#   python3 -c "import secrets; print(secrets.token_hex(16))"
POSTGRES_PASSWORD=

# ClickHouse password. Use a different value from POSTGRES_PASSWORD.
#   python3 -c "import secrets; print(secrets.token_hex(16))"
CLICKHOUSE_PASSWORD=

# Password of the ClickHouse user the erasure relay deletes with (clickhouse/np-erase-user.xml). It may only ALTER DELETE on the
# events table and read its distinct_id column, and only from the erase-relay container (OI-PRIV-50). Different from every
# other password here.
#   python3 -c "import secrets; print(secrets.token_hex(16))"
ERASE_CLICKHOUSE_PASSWORD=

# ── PostHog version ───────────────────────────────────────────────────────────
# REQUIRED. Set this to a specific PostHog release tag. The stack refuses to start while it is empty, and `latest`
# is not a pin: it changes between pulls, so an upgrade would happen without anyone choosing it.
# PostHog releases: https://github.com/PostHog/posthog/releases
#
# Example:
#   POSTHOG_VERSION=release-1.43.0
#
# Pin before any data exists, so that upgrades are intentional and tested against the changelog.
POSTHOG_VERSION=

# ── Network ──────────────────────────────────────────────────────────────────

# External URL where PostHog is accessible.
# Used in PostHog-generated links (email, API responses) and must match
# what clients actually reach this server at.
#
#   iOS Simulator (local):       http://localhost:8000
#   Physical device (local net): https://192.168.x.x  ← your Mac's LAN IP, through Caddy:
#                                POSTHOG_HOST=192.168.x.x docker compose --profile https up -d
#   Production (HTTPS):          https://analytics.yourdomain.example
#
# Plain http:// works on this machine only. PostHog's port is published on 127.0.0.1 and nowhere else
# (docker-compose.yml), so that no client can skip Caddy's TLS; another device reaches the stack through
# the https profile. Do not publish the port on the LAN to make plain HTTP work (OI-PRIV-50).
#
SITE_URL=http://localhost:8000

# Port PostHog binds on the host. 8000 is the default.
# Change if another service already uses port 8000.
POSTHOG_PORT=8000

# Set to true if PostHog sits behind Caddy or another reverse proxy.
# When true, PostHog trusts X-Forwarded-For headers for the originating IP.
# Leave false for direct localhost access.
IS_BEHIND_PROXY=false

# ── HTTPS (only used with: docker compose --profile https up -d) ─────────────

# Hostname Caddy uses for TLS certificate issuance.
#   localhost       → Caddy generates a local CA + self-signed cert
#                     (run `docker exec <caddy-container> caddy trust` once)
#   analytics.yourdomain.example → Caddy obtains a Let's Encrypt cert
#                     (requires port 80/443 publicly reachable)
#
# See docs/neurone_posthog_config.md §6 for full HTTPS setup instructions.
POSTHOG_HOST=localhost

# ── Event retention ──────────────────────────────────────────────────────────

# How many days the analytics store keeps events. Enforced by a ClickHouse TTL that
# `python3 apply_event_retention.py --url http://localhost:8123 --apply` sets and `--check` verifies (run --check after every
# PostHog upgrade: a recreated table loses its TTL).
#
# WHY 30: NP-APP-TELEMETRY-001 §5 says a person who withdraws research consent has their pseudonymous analytics ID deleted from
# the vendor within 30 DAYS. Retention is what keeps that promise true while the erasure relay is unverified (OI-ANALYTICS-01).
# The principal set 30 on 2026-11-20 (NP-ANALYTICS-001 §3.4, §7.1).
#   - ABOVE 30: the policy is not met for every day over 30. The script says so on stderr. Only the principal may decide that.
#   - BELOW 30: the policy is met; the cost is long-term trend data.
#   - Above 365 is refused: it needs a formal DPA review.
EVENT_RETENTION_DAYS=30

# ── Scaling ──────────────────────────────────────────────────────────────────
# These defaults are appropriate for local development and low-traffic staging.
# For production, tune based on observed CPU/memory usage.

# Number of Gunicorn workers for the PostHog web server.
# Rule of thumb: 2 × CPU cores + 1, but 2 is fine for local.
POSTHOG_WORKERS=2
