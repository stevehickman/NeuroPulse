# NeurOne PostHog — Environment Configuration Template
# NP-ANALYTICS-001 §3.1, §7.3 (OI-ANALYTICS-03)
#
# Usage:
#   cp .env.example .env
#   Fill in every empty value below.
#   Never commit .env to git — it is listed in .gitignore. Make it readable by its owner only: chmod 600 .env

# ── The stack and its PostHog version ────────────────────────────────────────
# The stack is PostHog's own hobby compose file at one pinned commit, the digests of its images, and NeurOne's controls,
# applied in that order. `docker compose` reads this line, so every command in this directory uses all three.
# There is NO version to set here. PostHog publishes no versioned self-hosted releases any more (the release-x.y.z tags
# stopped): the version is the PostHog commit in posthog-pin.json, and the only way to change it is
#   python3 pin_posthog.py --commit <40-hex SHA>
# followed by the upgrade procedure of NP-ANALYTICS-001 §7.3. Do not point an image at `latest` or `master` by hand.
COMPOSE_FILE=docker-compose.hobby.yml:docker-compose.pin.yml:docker-compose.neurone.yml

# PostHog's hobby file still writes the app image as $REGISTRY_URL:$POSTHOG_APP_TAG. docker-compose.pin.yml replaces it with
# a digest, so these two values are never pulled; they are set only so the file renders.
REGISTRY_URL=posthog/posthog
POSTHOG_APP_TAG=pinned-by-digest

# ── Required secrets (each a different random value) ─────────────────────────
#   python3 -c "import secrets; print(secrets.token_hex(32))"

# Django's SECRET_KEY. Generate once and keep stable.
POSTHOG_SECRET=
# PostHog's field-encryption keys. Generate once and keep stable: changing it makes stored encrypted fields unreadable.
#   python3 -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_SALT_KEYS=
# Seals login codes and reset links on PostHog's CDP intake topic.
#   python3 -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(24)).decode())"
CDP_SEALED_STATE_KEYS=
BROWSERLESS_SECRET=
INTERNAL_REQUEST_TOKEN=
RECORDING_API_JWT_SECRET=
# Object storage keys. Each install needs its own: PostHog's file refuses to start without them.
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Password of the ClickHouse user the erasure relay deletes with (clickhouse/np-erase-user.xml). It may only ALTER DELETE on the
# events table and read its distinct_id column, and only from the erase-relay container (OI-PRIV-50). Different from every
# other password here.
#   python3 -c "import secrets; print(secrets.token_hex(16))"
ERASE_CLICKHOUSE_PASSWORD=

# Password of the ClickHouse user apply_event_retention.py runs as (clickhouse/np-retention-user.xml). It may only read
# system.tables and change the events table's TTL (NP-ANALYTICS-001 §7.7: every script has its own user). Different from every
# other password here. The script reads it as RETENTION_CLICKHOUSE_PASSWORD and refuses to run as PostHog's own user.
#   python3 -c "import secrets; print(secrets.token_hex(16))"
RETENTION_CLICKHOUSE_PASSWORD=

# NOT HERE, AND WHY: the old layout asked for POSTGRES_PASSWORD and CLICKHOUSE_PASSWORD. PostHog's current layout does not read
# them: it connects to Postgres as posthog:posthog, and to ClickHouse through the users in PostHog's own users.xml, `default`
# with an empty password among them. Both are reachable only on analytics-internal, which no host port and no other machine
# reaches, but any container on that network can use them. Re-checked under OI-ANALYTICS-03 (4); a variable here would only
# suggest a protection the stack does not have.

# ── Network ──────────────────────────────────────────────────────────────────

# The host name PostHog builds its links from (SITE_URL is https://$DOMAIN) and Caddy's TLS host. They are the same name.
#   localhost                      → Caddy generates a local CA and a self-signed cert
#                                    (run `docker exec $(docker compose ps -q proxy) caddy trust` once)
#   192.168.x.x                    → a physical device on the local network, through Caddy's TLS (a self-signed cert for that address)
#   analytics.yourdomain.example   → Caddy obtains a Let's Encrypt cert (ports 80/443 publicly reachable)
DOMAIN=localhost
POSTHOG_HOST=localhost
# Read only by PostHog's own proxy, which this stack replaces with NeurOne's Caddy; set so the file renders. Leave it empty.
TLS_BLOCK=

# Plain http://localhost:8000 works on this machine only (the iOS Simulator, a local browser): Caddy publishes that port on
# 127.0.0.1 and nowhere else, so that no client can skip TLS. Another device uses https:// through POSTHOG_HOST. Do not
# publish the port on the LAN to make plain HTTP work (OI-PRIV-50). Change the number if another service already uses 8000.
POSTHOG_PORT=8000

# ── Event retention ──────────────────────────────────────────────────────────

# How many days the analytics store keeps events. Enforced by a ClickHouse TTL that
# `python3 apply_event_retention.py --url http://localhost:8123 --apply` sets and `--check` verifies (run --check after every
# PostHog upgrade: a recreated table loses its TTL).
#
# WHY 30: NP-APP-TELEMETRY-001 §5 says a person who withdraws research consent has their pseudonymous analytics ID deleted from
# the vendor within 30 DAYS. Retention is what keeps that promise true while the erasure relay is unverified (OI-ANALYTICS-01).
# The principal set 30 on 2026-11-20 (NP-ANALYTICS-001 §3.4, §7.1).
#   - ABOVE 30: the policy is not met for every day over 30. The script says so on stderr. Only the principal may decide that.
#   - BELOW 30: the policy is met; the cost is long-term trend data.
#   - Above 365 is refused: it needs a formal DPA review.
EVENT_RETENTION_DAYS=30

# ── Scaling (PostHog's own defaults; raise on a larger host) ─────────────────
GRANIAN_WORKERS=2
CELERY_WORKER_CONCURRENCY=2
