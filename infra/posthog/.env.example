# NeuroPulse PostHog — Environment Configuration Template
# NP-ANALYTICS-001 Rev A
#
# Usage:
#   cp .env.example .env
#   Fill in all required values below (marked with [REQUIRED])
#   Never commit .env to git — it is listed in .gitignore

# ── Required secrets ─────────────────────────────────────────────────────────

# Django secret key. Generate once and keep stable.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# PostgreSQL password. Use a strong random value.
#   python3 -c "import secrets; print(secrets.token_hex(16))"
POSTGRES_PASSWORD=

# ClickHouse password. Use a different value from POSTGRES_PASSWORD.
#   python3 -c "import secrets; print(secrets.token_hex(16))"
CLICKHOUSE_PASSWORD=

# ── PostHog version ───────────────────────────────────────────────────────────
# IMPORTANT: Pin to a specific release before any non-development use.
# PostHog releases: https://github.com/PostHog/posthog/releases
#
# Examples:
#   POSTHOG_VERSION=latest          ← OK for initial local bring-up only
#   POSTHOG_VERSION=release-1.43.0  ← Pinned (preferred for all persistent installs)
#
# Why pin? Unpinned latest can break between pulls. Pin before data exists so
# that upgrades are intentional and tested against the changelog.
POSTHOG_VERSION=latest

# ── Network ──────────────────────────────────────────────────────────────────

# External URL where PostHog is accessible.
# Used in PostHog-generated links (email, API responses) and must match
# what clients actually reach this server at.
#
#   iOS Simulator (local):       http://localhost:8000
#   Physical device (local net): http://192.168.x.x:8000  ← your Mac's LAN IP
#   Production (HTTPS):          https://analytics.yourdomain.example
#
SITE_URL=http://localhost:8000

# Port PostHog binds on the host. 8000 is the default.
# Change if another service already uses port 8000.
POSTHOG_PORT=8000

# Set to true if PostHog sits behind Caddy or another reverse proxy.
# When true, PostHog trusts X-Forwarded-For headers for the originating IP.
# Leave false for direct localhost access.
IS_BEHIND_PROXY=false

# ── HTTPS (only used with: docker compose --profile https up -d) ─────────────

# Hostname Caddy uses for TLS certificate issuance.
#   localhost       → Caddy generates a local CA + self-signed cert
#                     (run `docker exec <caddy-container> caddy trust` once)
#   analytics.yourdomain.example → Caddy obtains a Let's Encrypt cert
#                     (requires port 80/443 publicly reachable)
#
# See docs/neuropulse_posthog_config.md §6 for full HTTPS setup instructions.
POSTHOG_HOST=localhost

# ── Scaling ──────────────────────────────────────────────────────────────────
# These defaults are appropriate for local development and low-traffic staging.
# For production, tune based on observed CPU/memory usage.

# Number of Gunicorn workers for the PostHog web server.
# Rule of thumb: 2 × CPU cores + 1, but 2 is fine for local.
POSTHOG_WORKERS=2
