# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log

# ── Claude Code ───────────────────────────────────────────────────────────────
.claude/

# ── Firmware build artifacts ───────────────────────────────────────────────────
build/
firmware/build/
firmware/*/build/
# ARM/ELF outputs (never commit binaries)
*.elf
*.bin
*.hex
*.map
*.lst
*.su         # stack usage files (arm-none-eabi -fstack-usage)
*.d          # dependency files

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
*.egg

# ── Node / Web ────────────────────────────────────────────────────────────────
node_modules/
app/web/node_modules/
app/web/dist/
simulator/server/node_modules/
# Bun lockfile is committed; npm lockfile is not (bun-only project)
package-lock.json

# ── Xcode ─────────────────────────────────────────────────────────────────────
app/ios/build/
build/ios/
app/ios/*.xcodeproj/xcuserdata/
app/ios/*.xcodeproj/project.xcworkspace/xcuserdata/
# watchOS project is generated from app/watchos/project.yml via XcodeGen
# (`cd app/watchos && xcodegen generate`; CI does this in .github/workflows/watchos-ci.yml).
# The generated project is not committed — the spec is the source of truth.
app/watchos/*.xcodeproj/
*.xcuserstate
*.xcscmblueprint
DerivedData/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

# ── Swift Package Manager ─────────────────────────────────────────────────────
.build/
.swiftpm/
*.resolved     # resolved versions — commit only if you pin SPM deps deliberately

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── CI artifacts ──────────────────────────────────────────────────────────────
build/host-tests/
*.xcresult
