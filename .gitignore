# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log

# ── Claude Code ───────────────────────────────────────────────────────────────
.claude/

# ── Firmware build artifacts ───────────────────────────────────────────────────
build/
firmware/build/
firmware/*/build/
# ARM/ELF outputs (never commit binaries)
*.elf
*.bin
*.hex
*.map
*.lst
*.su         # stack usage files (arm-none-eabi -fstack-usage)
*.d          # dependency files

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
*.egg

# ── Node / Web ────────────────────────────────────────────────────────────────
node_modules/
app/web/node_modules/
app/web/dist/
simulator/server/node_modules/
# Bun lockfile is committed; npm lockfile is not (bun-only project)
package-lock.json

# ── Generated locale artifacts (CLAUDE.md §17) ────────────────────────────────
# locales/*.json is the single committed copy of every user-facing string. The
# per-platform files are build outputs, regenerated from canonical by each app's
# own build (Vite plugin, Gradle syncLocales task, Xcode run-script phase) — see
# scripts/sync-locales.ts. Committing one makes it a second source of truth,
# which is how the String Catalog once accumulated 26 keys canonical never had;
# `bun scripts/sync-locales.ts --verify-untracked` fails CI if one comes back.
# (Android's output lands under app/android/app/build/, already ignored above.)
app/ios/NeurOne/Localizable.xcstrings
app/web/src/generated/

# ── Xcode ─────────────────────────────────────────────────────────────────────
app/ios/build/
build/ios/
# Both Apple projects are generated from their project.yml via XcodeGen and are
# not committed — the spec is the source of truth, and a generated file under
# version control is a second one whether or not anyone means it to be
# (CLAUDE.md §17.5; Issue #189, which unified iOS onto the watchOS convention).
# Bootstrap a checkout with `cd app/ios && xcodegen generate` and
# `cd app/watchos && xcodegen generate`; CI regenerates in ios-ci.yml and
# watchos-ci.yml before any xcodebuild invocation.
app/ios/*.xcodeproj/
app/watchos/*.xcodeproj/
*.xcuserstate
*.xcscmblueprint
DerivedData/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

# ── Swift Package Manager ─────────────────────────────────────────────────────
.build/
.swiftpm/
*.resolved     # resolved versions — commit only if you pin SPM deps deliberately

# ── Android / Gradle ──────────────────────────────────────────────────────────
.gradle/
local.properties
# NOTE: the Gradle wrapper IS committed — gradlew, gradlew.bat, and
# gradle/wrapper/gradle-wrapper.jar must NOT be ignored (they are not matched
# by the rules above; *.jar is deliberately not a blanket ignore).

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── CI artifacts ──────────────────────────────────────────────────────────────
build/host-tests/
*.xcresult
